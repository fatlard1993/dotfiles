#!/bin/zsh

alias icat="kitty +kitten icat"

[[ -o interactive ]] || return
[[ -n "$CLAUDECODE" ]] && return
[[ -n "$KITTY_WINDOW_ID" ]] || return

claude() {
  kitty-bg
  # JIT spinner verbs: weighted draw by repo/hour/season/moon/weather.
  # Fail-soft — a missing compiler or sidecar just means default verbs.
  "$HOME/.priv-config/claude/compile-spinner.sh" 2>/dev/null || true
  printf '\033[3J'; clear
  if [[ -f "$HOME/.claude/spinner.json" ]]; then
    command claude --settings "$HOME/.claude/spinner.json" "$@"
  else
    command claude "$@"
  fi
  local rc=$?
  printf '\033[3J'; clear
  reload
  return $rc
}