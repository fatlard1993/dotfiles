#!/bin/zsh

# Change the colors: https://geoff.greer.fm/lscolors/

export LS_COLORS='di=34:ln=36:so=0:pi=0:ex=32:bd=0:cd=0:su=0:sg=0:tw=34:ow=34'

# ls defaults
#
# Plain `ls` here, not gls: this file is sourced on every platform, and gls is
# macOS-only (brew coreutils). macos/.zshrc.d/ls swaps in the GNU one, which is
# the direction the override should run - shared holds what works anywhere.
#
# --color=auto, never a bare --color: bare means "always" in GNU ls, so it
# colors straight through a pipe and anything parsing the output gets escape
# codes glued to the filenames. An explicit flag also outranks NO_COLOR
# (.zshenv.d/claude), so =auto is what actually defers to both it and the TTY.
alias ls="command ls --color=auto"

# List all files in long format, excluding . and ..
# List all files in long format
#
# auto rather than a $CLAUDECODE branch: the thing that actually matters is
# whether stdout is a terminal, which covers pipes, scripts and subshells too -
# not just this one agent.
alias l="ls -lAF --color=auto --group-directories-first"
alias la="ls -laF --color=auto --group-directories-first"

# List only directories
alias lsd="ls -lF | grep --color=never '^d'"
