#!/bin/zsh

# Shared by every profile's dot-update.d/minecraft and by mc-play. ender-launcher does the
# launcher's work; what is left here is what no launcher knows: where the house server
# lives, and whether the game is open right now.

# The first meaningful line of a priv-config file, or nothing. These live in priv-config
# rather than here because this repository is public.
mcPrivLine() {
	local file=${MINECRAFT_DATA:-$HOME/.priv-config/minecraft}/$1

	[[ -r $file ]] || return 1

	local value=$(grep -vE '^\s*(#|$)' $file | head -1 | tr -d '[:space:]')

	[[ -n $value ]] && echo $value
}

mcServerAddress() {
	mcPrivLine server-address.txt
}

# The game and loader versions the whole house runs. Bump with pandorical's
# gradle.properties in the same breath: a client on a different pin cannot join the server,
# and these drifted apart once already - five profiles sat on 26.3-rc-1 while both the suite
# and the server had moved to 26.3. `mc-server-version` asks the server what it is actually
# running, which is the only authority; the jar's filename is not one.
mcSuiteVersion=26.3
mcSuiteLoaderVersion=0.19.5

# The pack every client follows: the suite's client mods and sodium, as released, in an ender
# pack on a gist (justfatpack-client). What a client runs is edited there, not here - each
# client reads it again on every launch and every dot-update. sodium is in it because the
# htpc measured its GPU at 100% on the peaks driving a 4K projector, and the laptops have a
# good deal less card than that.
mcSuitePack=gist:a1db98319884288ad3d83a0db854291f

# Hosts the house has stopped running. A dead address does not leave servers.dat on its
# own; it stays under the name it always had and answers with a connection refused.
mcRetiredServers=(htpc.home 192.168.1.151)

# Whether a game is open on this directory. Asked of /proc, not of the command line: a
# launcher need not put the game dir on the java line, and a command-line match then
# reports "clear" with a game open in front of it.
mcGameRunning() {
	# Refused rather than guessed at: an empty root turns the test below into the pattern
	# "/*", which every absolute path matches.
	[[ -n $1 ]] || return 1

	local root=$(readlink -f $1 2>/dev/null || echo $1)
	local dir target fd

	for dir in /proc/[0-9]*; do
		[[ $(cat $dir/comm 2>/dev/null) == java ]] || continue

		target=$(readlink $dir/cwd 2>/dev/null)

		[[ $target == $root || $target == $root/* ]] && return 0

		for fd in $dir/fd/*(N); do
			target=$(readlink $fd 2>/dev/null) || continue

			[[ $target == $root/* ]] && return 0
		done
	done

	return 1
}

# Point a game directory's server list at the house server and drop the retired entries.
# Skipped while the game is open: Minecraft rewrites servers.dat on exit from what it read
# at startup, so an edit underneath it is thrown away.
mcEnsureServerList() {
	local gameDir=$1
	local address

	[[ -n $gameDir ]] || return

	address=$(mcServerAddress) || {
		echo "  No server address in priv-config, so the server list is left as it is"

		return
	}

	if mcGameRunning $gameDir; then
		echo "  The game is open, so the server list is left as it is - it would be"
		echo "  overwritten from memory when the game closes. Run this again after."

		return
	fi

	mkdir -p $gameDir

	# Pairs, not prefixed strings: zsh does not word-split an unquoted expansion, so
	# "--retire host" would arrive as one argument and not as a flag.
	local -a retire
	local host

	for host in $mcRetiredServers; do
		retire+=(--retire $host)
	done

	python3 $HOME/.dotfiles/bin/mc-servers $gameDir/servers.dat $retire home $address \
		|| echo "  The server list could not be written, so the retired entries are still in it" >&2
}

# The launcher, cloned and linked. Pulled rather than reset: on the dev machine this is a
# working tree, so an update step must not throw away local work.
mcEnsureEnder() {
	local dir=$HOME/Projects/ender-launcher

	command -v bun > /dev/null 2>&1 || {
		echo "  No bun, so the launcher cannot be installed (dot-update.d/1_bun)"

		return 1
	}

	if [[ -d $dir/.git ]]; then
		git -C $dir pull -q --ff-only 2>/dev/null || echo "  ender-launcher has local work, so it was left where it is"
	else
		echo "Cloning ender-launcher"

		mkdir -p $(dirname $dir)
		# https: a cold machine has no key on GitHub yet.
		git clone -q https://github.com/fatlard1993/ender-launcher $dir || {
			echo "  Could not clone ender-launcher" >&2

			return 1
		}
	fi

	# A bun too old to read bun.lock writes its own back, which leaves the clone modified so
	# every later --ff-only pull refuses. Restored below, but only when this run is what
	# dirtied it: a lockfile change already in progress on the dev machine is real work.
	local lockDirtiedByThisRun=0
	git -C $dir diff --quiet -- bun.lock 2>/dev/null && lockDirtiedByThisRun=1

	local installLog
	installLog=$(cd $dir && bun install 2>&1)
	local installStatus=$?

	# The one install failure worth answering rather than reporting: dot-update.d/1_bun
	# keeps bun above a floor, but a clone can still outrun it.
	if (( installStatus )) && [[ $installLog == *"Unknown lockfile version"* ]]; then
		echo "  bun $(bun --version) is older than ender-launcher's lockfile, so it is being upgraded"

		bun upgrade > /dev/null 2>&1

		installLog=$(cd $dir && bun install 2>&1)
		installStatus=$?
	fi

	(( lockDirtiedByThisRun )) && git -C $dir checkout -q -- bun.lock 2>/dev/null

	if (( installStatus )); then
		echo "  ender-launcher would not install:" >&2
		print -r -- $installLog | tail -5 | sed 's/^/    /' >&2

		return 1
	fi

	(cd $dir && bun link > /dev/null 2>&1) || {
		echo "  ender-launcher is installed but would not link" >&2

		return 1
	}

	command -v ender > /dev/null 2>&1 || {
		echo "  ender is not on PATH after linking - is ~/.bun/bin on it?" >&2

		return 1
	}

	# This file reads `ender ls --names`. An ender too old for it answers "Unknown flag",
	# which reads as "no instances", and the next step then creates one that already exists.
	# The pull above is deliberately non-fatal, so that stale clone is a reachable state.
	ender ls --names > /dev/null 2>&1 || {
		echo "  This ender is too old for 'ls --names', so the clone did not update" >&2

		return 1
	}
}

# The client id ender signs in with. Without one a machine still plays offline, which is
# all the house server asks for.
mcClientId() {
	mcPrivLine ender-client-id
}

# An instance matching the pin, created if missing and bumped if it has drifted.
#
# Sets mcInstanceChanged rather than returning it: a caller running a server needs to know
# that a pin moved under an already-started process, and a non-zero return would read as
# failure to every caller that writes `|| return`.
mcEnsureInstance() {
	local name=$1 version=$2 loader=$3 gameDir=$4 kind=$5 loaderVersion=$6
	local -a asServer

	mcInstanceChanged=0

	[[ $kind == server ]] && asServer=(--server)

	[[ -n $name && -n $version && -n $gameDir ]] || return 1

	if ender ls --names 2>/dev/null | grep -qxF $name; then
		local current=$(ender info $name 2>/dev/null | awk '$1 == "minecraft" { print $2 }')

		if [[ $current != $version ]]; then
			echo "Moving $name from $current to $version"

			ender bump $version --instance $name > /dev/null || return 1

			mcInstanceChanged=1
		fi
	else
		echo "Creating the $name instance ($version, ${loader:-fabric})"

		# Client or server is fixed at creation: it decides what gets provisioned.
		ender new $name --minecraft $version --loader ${loader:-fabric} --game-dir $gameDir $asServer > /dev/null || return 1

		mcInstanceChanged=1
	fi

	# Every run, not at creation: the pin moving is what changes it, and a loader version
	# left behind is the failure that looks like a mod problem. Empty means unpinned.
	if [[ -n $loaderVersion ]]; then
		ender set loaderVersion $loaderVersion --instance $name > /dev/null 2>&1 \
			|| echo "  $name kept its old loader version, which will look like a mod problem" >&2
	fi

	return 0
}

# The suite's source, cloned into ~/Projects/minecraft: what a machine needs before it can
# build any of it, and what the dellbook's client and server are downstream of.
#
# Membership is a GitHub topic rather than a list kept in this repo, because a
# list is a thing to forget: a mod started next month joins by being tagged, and
# every machine picks it up on its next update. The account carries 114 repos and
# the topic is the only thing that separates the suite from the rest of them.
#
# Missing clones only - existing ones are left alone. These are working trees
# with uncommitted work in them as often as not, and a dot-update that pulled
# forty repos underneath you would be a maintenance step nobody could trust.
mcEnsureSuite() {
	local root=$HOME/Projects/minecraft
	local suiteTopic="minecraft-mod-suite"
	local suiteOwner=$(git config --global github.user)
	local -a suiteRepos
	local suiteJson suiteTotal repo cloned

	if [[ -z $suiteOwner ]]; then
		echo "  No git github.user, so the suite cannot be located (priv-config git.config sets it)"
	else
		mkdir -p $root

		# gh when it is logged in, the public search API when it is not. Nothing
		# else here needs gh signed in: priv-config is cloned over ssh with the key
		# priv-config itself manages, so a machine can be fully set up with gh
		# never authenticated - which is exactly what the new laptop was, and the
		# first version of this block refused to clone anything on it.
		#
		# The mods are public repos, so the unauthenticated query answers fine. It
		# is rate limited at ten searches a minute, which one run of dot-update is
		# in no danger of.
		#
		# --limit / per_page are not optional: gh pages at 30 and the API at 30,
		# which would have quietly fetched the first thirty and left the rest to
		# turn up later as compile errors.
		if command -v gh > /dev/null && gh auth status > /dev/null 2>&1; then
			suiteRepos=(${(f)"$(gh repo list $suiteOwner --topic $suiteTopic --limit 200 --json name --jq '.[].name' 2>/dev/null)"})
		else
			suiteJson=$(curl -sf "https://api.github.com/search/repositories?q=user:$suiteOwner+topic:$suiteTopic&per_page=100" 2>/dev/null)
			suiteRepos=(${(f)"$(print -r -- $suiteJson | jq -r '.items[].name' 2>/dev/null)"})

			# The API reports how many it matched separately from how many it
			# returned; a suite that outgrows one page should say so rather than
			# silently clone the first hundred.
			suiteTotal=$(print -r -- $suiteJson | jq -r '.total_count // 0' 2>/dev/null)
			(( suiteTotal > ${#suiteRepos} )) && echo "  $suiteTotal repos carry the topic but only ${#suiteRepos} fit one page - this needs paginating"
		fi

		if (( ${#suiteRepos} == 0 )); then
			echo "  No repos carry the $suiteTopic topic - nothing to clone"
		else
			cloned=0
			for repo in $suiteRepos; do
				[[ -d $root/$repo/.git ]] && continue

				echo "Cloning $repo into the suite"

				# https, not ssh: a cold machine has no key on GitHub yet, and this
				# is the same reason dot-update.d/slock clones over https.
				git -C $root clone -q https://github.com/$suiteOwner/$repo && cloned=$((cloned + 1))
			done

			(( cloned > 0 )) && echo "  cloned $cloned of ${#suiteRepos} suite repo(s)"
		fi
	fi

	return 0
}

# An offline identity to play as, when nobody has signed one in. The house server runs
# offline-mode, so this is all it asks for.
mcEnsureOfflineAccount() {
	local name=${1:-$USER}

	# Bare names, not the human listing: matching that by shape also matched the indented
	# help printed under "No accounts yet.", so a machine with no account read as having one.
	[[ -n $(ender account --names 2>/dev/null) ]] && return 0

	echo "Adding an offline account for $name"

	ender account add --offline $name > /dev/null 2>&1 || {
		echo "  \"$name\" is not a usable Minecraft name - add one with ender account add --offline <name>" >&2

		return 1
	}
}

# The instance following the house pack, and current with it. Following it again is only an
# update, so this runs every time. Skipped while the game is open: replacing a jar under a
# running game breaks it the first time a class is wanted from the old one. Non-fatal: the
# launch updates again anyway, and a machine offline right now still has what it had.
mcFollowSuitePack() {
	local name=$1 gameDir=$2 followLog

	if [[ -n $gameDir ]] && mcGameRunning $gameDir; then
		echo "  The game is open, so $name's mods are left as they are; its next launch updates them"

		return 0
	fi

	followLog=$(ender follow $mcSuitePack --instance $name 2>&1) || {
		echo "  $name could not follow the pack ($mcSuitePack):" >&2
		print -r -- $followLog | tail -5 | sed 's/^/    /' >&2

		return 0
	}

	print -r -- $followLog | grep -E '^\s+[+-] |^!! |^ok ' | sed 's/^/  /'
}

# A player's machine: an instance on the pin following the house pack, an identity, and the
# server list.
mcEnsurePlayerClient() {
	local version=$1 loader=${2:-fabric} gameDir=$3 name=${4:-suite} loaderVersion=$5

	[[ -n $version && -n $gameDir ]] || return 1

	mcEnsureEnder || return 1

	mkdir -p $gameDir/mods

	mcEnsureInstance $name $version $loader $gameDir '' $loaderVersion || {
		echo "  The $name instance could not be set up" >&2

		return 1
	}

	mcFollowSuitePack $name $gameDir

	mcEnsureOfflineAccount || echo "  This machine has no identity to play as" >&2

	# Optional: with a client id this machine can also sign in to a Microsoft account, which
	# the house server does not need but another server might.
	local clientId
	clientId=$(mcClientId) && { ender config clientId $clientId > /dev/null || echo "  The client id would not apply" >&2 }

	mcEnsureServerList $gameDir

	# Pandorical draws every server-side screen and HUD in the suite, so a client without it
	# connects and cannot see half of what it joined - worth saying out loud.
	local -a carried
	carried=($gameDir/mods/pandorical-*.jar(N:t))

	if (( ! ${#carried} )); then
		echo "  No Pandorical in $gameDir/mods, so this machine cannot properly join the house"
		echo "  server. ender follow $mcSuitePack --instance $name says why it did not arrive."
	fi
}

# A non-house server's pack instance. Only a report when it is missing: ender imports a pack
# file but cannot fetch one from CurseForge by name.
mcEnsurePackInstance() {
	local name=$1 where=$2 gameDir=$3

	ender ls --names 2>/dev/null | grep -qxF $name && return 0

	echo "  No '$name' instance yet. Download its pack from $where, then:"
	echo "    ender import <the pack zip> --name $name --game-dir $gameDir"
}
