#!/usr/bin/env node
// Locate the npm global root that contains ts-morph.
// Searches the current nvm version first, then all others newest-first.
// Used by ctx-* tools: globalRoot=$(ctx-ts-morph-root)
const { execSync } = require('child_process')
const fs = require('fs')
const path = require('path')

function find() {
  // 1. Current global root
  try {
    const root = execSync('npm root -g 2>/dev/null', { encoding: 'utf8' }).trim()
    if (fs.existsSync(path.join(root, 'ts-morph'))) return root
  } catch {}

  // 2. Walk nvm versions newest-first
  const nvmVersions = path.join(process.env.HOME, '.nvm', 'versions', 'node')
  try {
    const versions = fs.readdirSync(nvmVersions)
      .filter(v => v.startsWith('v'))
      .sort((a, b) => {
        const parse = v => v.slice(1).split('.').map(Number)
        const [a0,a1,a2] = parse(a), [b0,b1,b2] = parse(b)
        return b0-a0 || b1-a1 || b2-a2   // descending
      })
    for (const v of versions) {
      const root = path.join(nvmVersions, v, 'lib', 'node_modules')
      if (fs.existsSync(path.join(root, 'ts-morph'))) return root
    }
  } catch {}

  // 3. Fallback — will error at require time with a clear path
  return execSync('npm root -g 2>/dev/null', { encoding: 'utf8' }).trim()
}

process.stdout.write(find())
