#!/usr/bin/env bash
# Restart the house server so it takes what was released since it last started.
#
#   mc-deploy          restart it, unless someone is playing
#   mc-deploy --now    restart it even so; whoever is on is disconnected
#
# The server follows the house server pack (mcServerPack in bin/lib/minecraft) and reads it
# each time it starts, so a deploy is a release followed by a restart, and the nightly
# restart does that on its own. Nothing is swapped under a running server: the JVM reads
# classes from a jar lazily, so one replaced under it fails later, on the first class nobody
# had needed yet. Unreleased builds are tried on a local server, not here.
set -euo pipefail

HOST=${MC_HOST:-vps}
PORT=${MC_PORT:-25565}

now=0
for arg in "$@"; do
	case "$arg" in
		--now) now=1 ;;
		*) echo "usage: mc-deploy [--now]" >&2; exit 2 ;;
	esac
done

# On the server's own box there is nowhere to ssh to, so the same commands run here.
if [ "$(cat "$HOME/.dotfilesProfile" 2>/dev/null)" = "$HOST" ]; then
	on_host() { bash -c "$1"; }
else
	on_host() { ssh -n "$HOST" "$1"; }
fi

players=$(on_host "ss -Htn state established '( sport = :$PORT )' | wc -l")

if [ "$players" -gt 0 ] && [ "$now" -eq 0 ]; then
	echo "$players connected to the server; a restart disconnects them. mc-deploy --now restarts anyway," >&2
	echo "or leave it to the nightly restart." >&2
	exit 1
fi

since=$(on_host "date '+%Y-%m-%d %H:%M:%S'")

echo "Restarting the server on $HOST; it reads the server pack as it starts"
on_host "systemctl --user restart minecraft-server.service"

# Up when the game says Done, not when systemd says active: the update runs first, inside the
# start, and active is reported the moment the process begins.
for _ in $(seq 1 90); do
	log=$(on_host "journalctl --user -u minecraft-server.service --since '$since' --no-pager -o cat" 2>/dev/null || true)

	if grep -q 'Done (' <<< "$log"; then
		grep -E '^  [+-] |->|^!! |^xx |^ok ' <<< "$log" | sed 's/^/  /' || true
		echo "The server is up"
		exit 0
	fi

	if ! on_host "systemctl --user is-active --quiet minecraft-server.service"; then
		echo "The server stopped while starting:" >&2
		tail -15 <<< "$log" | sed 's/^/  /' >&2
		exit 1
	fi

	sleep 5
done

echo "The server has not said Done after 7 minutes; its log:" >&2
tail -15 <<< "$log" | sed 's/^/  /' >&2
exit 1
