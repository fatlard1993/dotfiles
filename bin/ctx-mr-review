#!/usr/bin/env bash
# ctx-mr-review — deterministic bug detection on a branch diff
# Checks: signature drift vs call sites, removed guards, dropped error handling,
#         new dissonance patterns, broken invariants, type contract violations
# Usage: ctx-mr-review [branch] [--base <ref>]
#
# Synthesis layer: Agent(subagent_type="ctx-reviewer") wraps this tool and
# produces structured 🔴/🟡 findings with a merge recommendation.

set -eo pipefail

branch="${1:-HEAD}"
base="main"
while [[ $# -gt 0 ]]; do
    case "$1" in --base) base="$2"; shift 2 ;; *) shift ;; esac
done

# Validate refs
git rev-parse "$base" > /dev/null 2>&1 || { echo "base ref not found: $base"; exit 1; }
git rev-parse "$branch" > /dev/null 2>&1 || { echo "branch ref not found: $branch"; exit 1; }

echo "## MR Review: $base → $branch"
echo ""

# Changed TypeScript files
changed_files=$(git diff --name-only "${base}...${branch}" 2>/dev/null | grep -E '\.(ts|tsx|js|jsx|mjs)$' | grep -v '\.d\.ts$' | grep -v '\.test\.' | grep -v '\.spec\.' || true)
# Same set including tests — a type error in a new test file is still this branch's to answer for.
changed_files_with_tests=$(git diff --name-only "${base}...${branch}" 2>/dev/null | grep -E '\.(ts|tsx|js|jsx|mjs)$' | grep -v '\.d\.ts$' || true)

# --- Dependency bump detection (runs even when no source files changed) ---
pkg_changed=$(git diff --name-only "${base}...${branch}" 2>/dev/null | grep -E '^package\.json$' || true)
lock_changed=$(git diff --name-only "${base}...${branch}" 2>/dev/null | grep -E '^package-lock\.json$|^bun\.lockb$|^yarn\.lock$' || true)

if [[ -n "$pkg_changed" ]]; then
    echo "### Dependency Changes"
    echo ""

    bumped=$(git diff "${base}...${branch}" -- package.json 2>/dev/null \
        | grep '^[+-]' | grep -v '^---\|^+++' \
        | grep -oE '"[@a-z@/][^"]+": "[^"]+"' \
        | sort | uniq -u | head -20 || true)

    # Extract changed packages using jq for reliability
    tmp_pkg=$(mktemp)
    trap 'rm -f "$tmp_pkg"' EXIT

    # Get old and new package.json as JSON, compare dependencies
    git show "${base}:package.json" 2>/dev/null > "${tmp_pkg}.old" || true
    cp package.json "${tmp_pkg}.new" 2>/dev/null || true

    if [[ -f "${tmp_pkg}.old" && -f "${tmp_pkg}.new" ]]; then
        for dep_key in dependencies devDependencies peerDependencies; do
            old_deps=$(jq -r ".${dep_key} // {} | to_entries[] | \"\(.key)=\(.value)\"" "${tmp_pkg}.old" 2>/dev/null || true)
            new_deps=$(jq -r ".${dep_key} // {} | to_entries[] | \"\(.key)=\(.value)\"" "${tmp_pkg}.new" 2>/dev/null || true)

            # Find packages that changed or were removed
            while IFS='=' read -r pkg old_ver; do
                [[ -z "$pkg" ]] && continue
                new_ver=$(echo "$new_deps" | grep "^${pkg}=" | cut -d= -f2- || true)

                if [[ -z "$new_ver" ]]; then
                    # Removed
                    echo "  📦 $pkg: $old_ver → (removed)"
                elif [[ "$old_ver" != "$new_ver" ]]; then
                    # Changed
                    echo "  📦 $pkg"
                    echo "     $old_ver → $new_ver"
                    if [[ -n "$lock_changed" ]]; then
                        resolved=$(jq -r ".packages[\"node_modules/${pkg}\"].version // empty" package-lock.json 2>/dev/null || true)
                        [[ -n "$resolved" ]] && echo "     Lock resolved: $resolved"
                    fi
                    if echo "$new_ver" | grep -q '^\^'; then
                        echo "     Range: ^ (allows minor/patch bumps automatically)"
                    elif echo "$new_ver" | grep -q '^\~'; then
                        echo "     Range: ~ (allows patch bumps only)"
                    fi
                    clean_ver=$(echo "$new_ver" | tr -d '^~>=<')
                    echo "     Changelog: https://www.npmjs.com/package/${pkg}/v/${clean_ver}"
                    echo ""
                fi
            done <<< "$old_deps"
        done
    fi
    rm -f "${tmp_pkg}.old" "${tmp_pkg}.new"

    # Quick audit check
    echo "  Running npm audit on changed dependencies..."
    audit_out=$(npm audit --audit-level=high 2>/dev/null | grep -E "^(found|high|critical)" | head -5 || true)
    if [[ -n "$audit_out" ]]; then
        echo "  🔴 Audit findings:"
        echo "$audit_out" | sed 's/^/    /'
        critical=$((critical + 1))
    else
        echo "  ✓ No high/critical vulnerabilities"
    fi
    echo ""
fi

if [[ -z "$changed_files" ]]; then
    # An empty commit range with a dirty tree means the work is uncommitted and this tool cannot
    # see it. Reporting "no issues" there is a clean bill of health for code never examined, so
    # say what happened and exit non-zero instead.
    uncommitted=$(git status --porcelain 2>/dev/null \
        | grep -E '\.(ts|tsx|js|jsx|mjs)$' | grep -v '\.d\.ts$' || true)
    if [[ -n "$uncommitted" ]]; then
        uncommitted_count=$(echo "$uncommitted" | wc -l | tr -d ' ')
        echo "⚠ NOT REVIEWED: ${base}...${branch} is empty, but $uncommitted_count changed source file(s)"
        echo "  are uncommitted. This tool diffs commits, so it never saw them."
        echo "  Commit the work, or review the working tree with: ctx-diff HEAD"
        echo ""
        echo "---"
        echo "⚠ INCONCLUSIVE: nothing was analyzed"
        exit 1
    fi

    [[ -z "$pkg_changed" ]] && echo "No source files or dependencies changed."
    # Still run summary
    echo "---"
    if [[ $critical -eq 0 && $warnings -eq 0 ]]; then
        echo "✓ No issues detected."
        exit 0
    elif [[ $critical -gt 0 ]]; then
        echo "🔴 CRITICAL: $critical issue(s)"
        exit 2
    else
        echo "🟡 WARNING: $warnings issue(s)"
        exit 1
    fi
fi

file_count=$(echo "$changed_files" | wc -l | tr -d ' ')
echo "Changed files: $file_count"
echo ""

critical=0
warnings=0
changed_fns_file=$(mktemp)
trap 'rm -f "$changed_fns_file"' EXIT

# Severity classification
is_critical() { echo "$1" | grep -qE 'GUARD-REMOVED|TRY-CATCH-REMOVED|params:.*→'; }
is_warning()  { echo "$1" | grep -qE 'THROW-LITERAL|CONSOLE|GHOST-CALL|UNHANDLED-REJECTION|DEAD-PARAM|LOOSE-EQ|OPEN-CIRCUIT|MUTATION'; }

# --- 1. Semantic diff on each changed file ---
echo "### Structural Changes"
echo ""

while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    result=$(ctx-semantic-diff "$f" "$base" "$branch" 2>/dev/null || true)
    [[ -z "$result" ]] && continue
    [[ "$result" == *"no structural changes"* ]] && continue

    # Tag lines with severity
    while IFS= read -r line; do
        if is_critical "$line"; then
            echo "  🔴 $line"
            critical=$((critical + 1))
        elif is_warning "$line"; then
            echo "  🟡 $line"
            warnings=$((warnings + 1))
        else
            echo "$line"
        fi
    done <<< "$result"
    echo ""

    # Record changed function names for call-site audit
    echo "$result" | grep "^  ~ " | sed 's/^  ~ //' | awk '{print $1}' | while read -r fname; do
        echo "$fname $f" >> "$changed_fns_file"
    done || true
done <<< "$changed_files"

# --- 1b. Migration check — detect library replacements ---
echo "### Migration Analysis"
echo ""

migration_found=false
while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    result=$(ctx-migration "$f" --base "$base" 2>/dev/null || true)
    [[ -z "$result" ]] && continue
    [[ "$result" == *"no recognized migration"* ]] && continue
    [[ "$result" == *"new file"* ]] && continue

    echo "$result"
    # Count flags — grep exits 1 if no match, arithmetic handles it cleanly
    mig_crit=$(echo "$result" | awk '/🔴/{c++} END{print c+0}')
    mig_warn=$(echo "$result" | awk '/🟡/{c++} END{print c+0}')
    critical=$((critical + mig_crit))
    warnings=$((warnings + mig_warn))
    migration_found=true
done <<< "$changed_files"

$migration_found || echo "  (no library migrations detected)"
echo ""

# --- 1c. TypeScript compilation check ---
echo "### TypeScript Compilation"
echo ""

git_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
tsconfig_path=""
[[ -f "$git_root/tsconfig.json" ]] && tsconfig_path="$git_root/tsconfig.json"

# A project's own typecheck script knows its layout — which tsconfig covers tests, which
# workspaces build separately. Prefer it; raw tsc against the root config is the fallback.
project_typecheck=""
if [[ -f "$git_root/package.json" ]] && command -v jq &>/dev/null; then
    for script_name in typecheck type-check tsc; do
        if jq -e --arg s "$script_name" '.scripts[$s] // empty' "$git_root/package.json" &>/dev/null; then
            project_typecheck="$script_name"
            break
        fi
    done
fi

if [[ -n "$project_typecheck" ]]; then
    pm="npm run"
    [[ -f "$git_root/yarn.lock" ]] && pm="yarn"
    [[ -f "$git_root/bun.lockb" ]] && pm="bun run"
    if (cd "$git_root" && timeout 300 $pm "$project_typecheck" &>/dev/null); then
        echo "  ✓ Project typecheck passes ($pm $project_typecheck)"
    else
        echo "  🔴 Project typecheck fails ($pm $project_typecheck) — run it directly for details"
        critical=$((critical + 1))
    fi
elif [[ -z "$tsconfig_path" ]]; then
    echo "  (no tsconfig.json found — skipping)"
else
    tsc_bin=""
    [[ -x "$git_root/node_modules/.bin/tsc" ]] && tsc_bin="$git_root/node_modules/.bin/tsc"
    [[ -z "$tsc_bin" ]] && command -v tsc &>/dev/null && tsc_bin="tsc"

    if [[ -z "$tsc_bin" ]]; then
        echo "  (tsc not available — run npm ci or install typescript globally to enable)"
    else
        all_tsc_errors=$(cd "$git_root" && timeout 120 $tsc_bin --noEmit --skipLibCheck 2>&1 \
            | grep " error TS" | sed "s|${git_root}/||g" || true)

        # The root tsconfig rarely describes a whole monorepo: workspaces with project references
        # report unresolved imports here that their real build never sees, and test files usually
        # need a separate config for their runner's globals. Only changed non-test files are held
        # against the branch; everything else is context, not a regression.
        in_diff_errors=""
        out_of_diff_errors=""
        if [[ -n "$all_tsc_errors" ]]; then
            while IFS= read -r err_line; do
                [[ -z "$err_line" ]] && continue
                err_file="${err_line%%(*}"
                if echo "$changed_files" | grep -qxF "$err_file"; then
                    in_diff_errors+="${err_line}"$'\n'
                else
                    out_of_diff_errors+="${err_line}"$'\n'
                fi
            done <<< "$all_tsc_errors"
        fi

        out_count=$(grep -c '' <<< "${out_of_diff_errors%$'\n'}" 2>/dev/null || echo 0)
        [[ -z "$out_of_diff_errors" ]] && out_count=0

        # Thousands of errors outside the diff means the root config does not describe this
        # project at all, so its verdict on the changed files is not worth much either.
        if [[ $out_count -gt 200 ]]; then
            echo "  ⚠ The root tsconfig reports $out_count errors across files this branch never"
            echo "    touched, so it does not describe this project's real build (monorepo"
            echo "    workspaces, project references, or a separate test config). Treating its"
            echo "    verdict on changed files as unreliable — run the project's own typecheck."
        elif [[ -n "$in_diff_errors" ]]; then
            in_count=$(grep -c '' <<< "${in_diff_errors%$'\n'}")
            echo "  🔴 TypeScript errors in changed files ($in_count):"
            head -10 <<< "${in_diff_errors%$'\n'}" | sed 's/^/    /'
            critical=$((critical + 1))
        else
            echo "  ✓ No TypeScript errors in changed source files (root tsconfig)"
            if [[ $out_count -gt 0 ]]; then
                echo "  ℹ $out_count error(s) elsewhere — pre-existing, in changed test files, or"
                echo "    outside the root config's scope. Not counted against this branch."
                head -3 <<< "${out_of_diff_errors%$'\n'}" | sed 's/^/      /'
            fi
        fi
    fi
fi
echo ""

# --- 2. Call-site audit for changed signatures ---
if [[ -s "$changed_fns_file" ]]; then
    echo "### Call-Site Audit"
    echo ""
    while IFS= read -r entry; do
        fname=$(echo "$entry" | awk '{print $1}')
        src_file=$(echo "$entry" | awk '{print $2}')

        call_sites=$(rg --no-heading --color=never -n "\b${fname}\s*(" . \
            --glob='!*.test.*' --glob='!*.spec.*' 2>/dev/null \
            | grep -v "^${src_file}:" || true)

        if [[ -n "$call_sites" ]]; then
            echo "  🔴 $fname — callers may use old signature:"
            echo "$call_sites" | head -5 | sed 's/^/    /'
            critical=$((critical + 1))
        fi
    done < "$changed_fns_file"
    echo ""
fi

# --- 3. New dissonance — only flags introduced by this MR, not pre-existing ---
echo "### New Dissonance in Changed Code"
echo ""

has_dissonance=false
# The old revision is analyzed from a temp copy, and ctx-test-gen picks its parser from the
# file extension — an extensionless temp yields zero flags, which would silently report every
# pre-existing flag as newly introduced. The suffix is added per file below.
tmp_old_dir=$(mktemp -d)
trap 'rm -rf "$tmp_old_dir"' EXIT

while IFS= read -r f; do
    [[ -f "$f" ]] || continue

    line_count=$(wc -l < "$f" | tr -d ' ')
    large_threshold=400

    # Build --only filter from changed functions in semantic diff (for large files)
    only_arg=""
    if [[ $line_count -gt $large_threshold ]]; then
        echo "  ⚠ $(basename "$f") is $line_count lines — analyzing changed functions only"

        # Get changed/added function names from the semantic diff
        changed_fns=$(ctx-semantic-diff "$f" "$base" "$branch" 2>/dev/null \
            | grep -E "^  [+~] " | sed 's/^  [+~] //' | awk '{print $1}' | tr '\n' ',' | sed 's/,$//' || true)

        if [[ -n "$changed_fns" ]]; then
            only_arg="--only=${changed_fns}"
            echo "    Functions: $changed_fns"
        fi
        echo ""
    fi

    # ctx-test-gen indents a flag by its nesting depth, so the same finding arrives at several
    # indents and survives sort -u as duplicates. Normalize before deduping and diffing.
    # LC_ALL=C throughout: flag lines hold multibyte characters (⚠, —) whose locale collation
    # can make sort and comm disagree, and comm on "unsorted" input silently emits pre-existing
    # flags as new. Byte order is stable.
    new_flags=$(timeout 60 ctx-test-gen "$f" $only_arg 2>/dev/null | grep "⚠" \
        | sed 's/^[[:space:]]*/  /' | LC_ALL=C sort -u || true)
    [[ -z "$new_flags" ]] && continue

    # Compare against old version — only show what's newly introduced
    git_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
    rel=$(cd "$git_root" && realpath --relative-to="." "$f" 2>/dev/null || echo "$f")
    old_content=$(git show "${base}:${rel}" 2>/dev/null || true)

    if [[ -n "$old_content" ]]; then
        tmp_old="${tmp_old_dir}/old.${f##*.}"
        echo "$old_content" > "$tmp_old"
        old_flags=$(timeout 60 ctx-test-gen "$tmp_old" $only_arg 2>/dev/null | grep "⚠" \
            | sed 's/^[[:space:]]*/  /' | LC_ALL=C sort -u || true)
        new_only=$(LC_ALL=C comm -23 <(echo "$new_flags") <(echo "$old_flags") 2>/dev/null || echo "$new_flags")
    else
        new_only="$new_flags"
    fi

    if [[ -n "$new_only" ]]; then
        echo "  $f:"
        while IFS= read -r flag; do
            [[ -z "$flag" ]] && continue
            if is_critical "$flag"; then
                echo "    🔴 $flag"; critical=$((critical + 1))
            else
                echo "    🟡 $flag"; warnings=$((warnings + 1))
            fi
        done <<< "$new_only"
        has_dissonance=true
    fi
done <<< "$changed_files"

$has_dissonance || echo "  (none)"
echo ""

# --- 4. Invariant check on changed files ---
echo "### Invariant Check"
echo ""

while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    inv=$(ctx-invariants "$f" 2>/dev/null | grep -v "^$\|^##\|no complementary" || true)
    if [[ -n "$inv" ]]; then
        echo "  🟡 $f — verify these roundtrips still hold:"
        echo "$inv" | grep "→" | sed 's/^/    /'
        warnings=$((warnings + 1))
    fi
done <<< "$changed_files"

echo ""

# --- 4b. Rhythm check — error signaling and return shape consistency ---
echo "### Rhythm"
echo ""

rhythm_found=false
while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    result=$(ctx-rhythm "$f" 2>/dev/null || true)
    [[ -z "$result" ]] && continue
    [[ "$result" == *"✓ Consistent"* ]] && continue

    echo "$result" | grep -E "🟡|🔴" | sed 's/^/  /'
    rhythm_w=$(echo "$result" | awk '/🟡/{c++} END{print c+0}')
    warnings=$((warnings + rhythm_w))
    rhythm_found=true
done <<< "$changed_files"

$rhythm_found || echo "  (no rhythm issues in changed files)"
echo ""

# --- 5. Env var regressions ---
echo "### Environment Variable Changes"
echo ""

new_env_vars=$(git diff "${base}...${branch}" -- $(echo "$changed_files") 2>/dev/null \
    | grep "^+" | grep -oE 'process\.env\.[A-Z_][A-Z0-9_]+' \
    | sed 's/process\.env\.//' | sort -u || true)

if [[ -n "$new_env_vars" ]]; then
    echo "  🟡 New env vars — verify documented and have fallbacks:"
    echo "$new_env_vars" | sed 's/^/    /'
    warnings=$((warnings + 1))
else
    echo "  (none)"
fi

echo ""

# --- 6. Test coverage check ---
echo "### Test Coverage"
echo ""

# Tests are looked up in the reviewed branch's tree, not the working tree: the branch under
# review is usually not the one checked out, and its new test files would otherwise be invisible.
branch_tree=$(git ls-tree -r --name-only "$branch" 2>/dev/null || true)
diff_files=$(git diff --name-only "${base}...${branch}" 2>/dev/null || true)

test_gap=false
while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    # Skip files that are themselves test files
    echo "$f" | grep -qE '\.(test|spec)\.' && continue

    base_name="${f%.*}"
    stem=$(basename "$base_name")

    # Colocated first, allowing an infix for repo-specific suites (foo.component.test.tsx,
    # foo.db.test.ts). Falling back to a basename match elsewhere in the tree catches suites
    # kept apart, e.g. test/server/middleware/errors.test.ts for controllers/.../errors.ts.
    test_files=$(grep -E "^${base_name}(\..+)?\.(test|spec)\.[a-z]+$" <<< "$branch_tree" || true)
    if [[ -z "$test_files" ]]; then
        test_files=$(grep -E "(^|/)${stem}(\..+)?\.(test|spec)\.[a-z]+$" <<< "$branch_tree" || true)
    fi

    if [[ -z "$test_files" ]]; then
        echo "  🟡 $(basename "$f") — no test file found"
        warnings=$((warnings + 1))
        test_gap=true
    else
        # A source file can have several suites (unit, db, component); any one of them being
        # touched means this change carries test work, so only flag when none were.
        touched=""
        while IFS= read -r tf; do
            [[ -z "$tf" ]] && continue
            grep -qxF "$tf" <<< "$diff_files" && { touched="$tf"; break; }
        done <<< "$test_files"

        if [[ -z "$touched" ]]; then
            names=$(while IFS= read -r tf; do [[ -n "$tf" ]] && basename "$tf"; done <<< "$test_files" | paste -sd ", " -)
            echo "  🟡 $(basename "$f") changed but its tests were not updated ($names)"
            warnings=$((warnings + 1))
            test_gap=true
        fi
    fi
done <<< "$changed_files"

$test_gap || echo "  (test files updated alongside source)"
echo ""

# --- 7. Formatter check ---
# A formatter is usually its own CI gate, and it fails on files a reviewer would call clean.
echo "### Formatting"
echo ""

prettier_bin=""
[[ -x "$git_root/node_modules/.bin/prettier" ]] && prettier_bin="$git_root/node_modules/.bin/prettier"

format_cap=40
if [[ -z "$prettier_bin" ]]; then
    echo "  (prettier not installed locally — skipping)"
elif [[ -z "$changed_files_with_tests" ]]; then
    echo "  (no formattable files changed)"
else
    file_total=$(grep -c '' <<< "$changed_files_with_tests")
    # Content is read from the branch rather than the working tree, since the branch under
    # review is usually not the one checked out. prettier has no branch-aware mode, so each
    # file is piped through --stdin-filepath and compared with what the branch actually holds.
    unformatted=""
    checked=0
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        [[ $checked -ge $format_cap ]] && break
        checked=$((checked + 1))
        # The trailing 'x' survives command substitution's newline stripping, so a file that
        # differs only by a missing or extra final newline is still caught.
        branch_content=$(git show "${branch}:${f}" 2>/dev/null; printf x) || true
        [[ "$branch_content" == "x" ]] && continue
        formatted=$(printf '%s' "${branch_content%x}" \
            | (cd "$git_root" && timeout 30 "$prettier_bin" --stdin-filepath "$f" 2>/dev/null; printf x) || true)
        [[ "$formatted" == "x" ]] && continue
        [[ "$branch_content" == "$formatted" ]] || unformatted+="${f}"$'\n'
    done <<< "$changed_files_with_tests"

    if [[ -n "$unformatted" ]]; then
        unformatted_count=$(grep -c '' <<< "${unformatted%$'\n'}")
        echo "  🟡 $unformatted_count file(s) are not prettier-formatted:"
        head -5 <<< "${unformatted%$'\n'}" | sed 's/^/    /'
        warnings=$((warnings + 1))
    else
        echo "  ✓ Changed files are formatted"
    fi
    [[ $file_total -gt $format_cap ]] && echo "  (checked first $format_cap of $file_total files)"
fi
echo ""

# --- 8. Config divergence check ---
# Check if this MR introduces code that diverges from declared Prettier/tsconfig config
echo "### Config Conformance"
echo ""

conventions_file=".claude/conventions.md"
if [[ -f "$conventions_file" ]]; then
    declared_qs=$(grep "Import quotes.*single" "$conventions_file" 2>/dev/null | head -1 || true)
    declared_qd=$(grep "Import quotes.*double" "$conventions_file" 2>/dev/null | head -1 || true)

    if [[ -n "$declared_qs" ]]; then
        # Declared single — check if MR introduces double-quoted imports
        double_in_diff=$(git diff "${base}...${branch}" -- $(echo "$changed_files") 2>/dev/null \
            | grep '^+' | grep -v '^+++' | grep -oE '^.*from "' | head -3 || true)
        if [[ -n "$double_in_diff" ]]; then
            echo "  🟡 MR introduces double-quoted imports but config declares single quotes:"
            echo "$double_in_diff" | head -3 | sed 's/^/    /'
            warnings=$((warnings + 1))
        else
            echo "  ✓ Import style matches declared config"
        fi
    elif [[ -n "$declared_qd" ]]; then
        single_in_diff=$(git diff "${base}...${branch}" -- $(echo "$changed_files") 2>/dev/null \
            | grep '^+' | grep -v '^+++' | grep -oE "^.*from '" | head -3 || true)
        if [[ -n "$single_in_diff" ]]; then
            echo "  🟡 MR introduces single-quoted imports but config declares double quotes"
            warnings=$((warnings + 1))
        else
            echo "  ✓ Import style matches declared config"
        fi
    else
        echo "  (no conventions file or import style not declared — run ctx-conventions first)"
    fi
else
    echo "  (no .claude/conventions.md — run ctx-conventions to enable)"
fi
echo ""

# --- Summary + exit code ---
echo "---"
if [[ $critical -eq 0 && $warnings -eq 0 ]]; then
    echo "✓ No issues detected. Review for logic and intent."
    exit 0
elif [[ $critical -gt 0 ]]; then
    echo "🔴 CRITICAL: $critical regression(s) — fix before merging"
    [[ $warnings -gt 0 ]] && echo "🟡 WARNING:  $warnings issue(s) — review"
    exit 2
else
    echo "🟡 WARNING: $warnings issue(s) — review before merging"
    exit 1
fi
