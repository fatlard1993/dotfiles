#!/usr/bin/env bash
# ctx-symbol — complete symbol investigation: definition, usages, and evolution
# Composes ctx-where, ctx-refs, and ctx-history into one call
# Usage: ctx-symbol <name> [path]

set -euo pipefail

name="${1:?usage: ctx-symbol <name> [path]}"
search_path="${2:-.}"

echo "## Definition"
defs=$(ctx-where "$name" "$search_path" 2>/dev/null)
if [[ -n "$defs" ]]; then
    echo "$defs"
else
    echo "  (not found)"
fi

echo ""
echo "## Usages"
ctx-refs "$name" "$search_path" 2>/dev/null


# Context lines from -A 1 use dash separator so they won't match
def_files=$(echo "$defs" | grep -oE '^[^:]+:[0-9]+:' | cut -d: -f1 | sort -u 2>/dev/null || true)

if [[ -n "$def_files" ]]; then
    while IFS= read -r f; do
        [[ -f "$f" ]] || continue
        echo ""
        echo "## History ($f)"
        ctx-history "$f" 5
    done <<< "$def_files"
fi
