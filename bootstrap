#!/bin/bash
set -e

repo_dir="$HOME/Projects/dotfiles"

echo "Installing base dependencies..."

case "$(uname -s)" in
Darwin)
	# Everything below needs git, and on a fresh mac `git` is a stub whose
	# only job is to trigger this install - so the clone cannot happen until
	# the command line tools are actually down. zsh and curl already ship.
	if xcode-select --print-path &> /dev/null; then
		echo "Xcode command line tools already installed"
	else
		echo "Installing Xcode command line tools..."

		xcode-select --install &> /dev/null || true

		# The installer is a separate GUI process and `xcode-select --install`
		# returns immediately - which is why the old README told you to wait
		# for the prompt and then re-run the whole thing by hand. Wait it out
		# here instead so bootstrap stays one command.
		echo "Accept the installer prompt - waiting for it to finish..."

		waited=0
		until xcode-select --print-path &> /dev/null; do
			if [ "$waited" -ge 1800 ]; then
				echo "Xcode command line tools still not installed after 30min, giving up" >&2
				exit 1
			fi

			sleep 10
			waited=$((waited + 10))
		done

		echo "Finished installing Xcode command line tools"
	fi
	;;
Linux)
	# A fresh install's unattended-upgrades holds the dpkg lock for many
	# minutes right after first boot - on the htpc's first bootstrap that
	# starved nearly every apt call in the chain, leaving half a profile.
	# This makes apt wait for the lock (up to 10min per call) instead of
	# failing, for this run and every dot-update after it.
	echo 'DPkg::Lock::Timeout "600";' | sudo tee /etc/apt/apt.conf.d/90dpkg-lock-timeout > /dev/null

	sudo apt update -y
	sudo apt install -y git zsh curl
	;;
*)
	echo "Unsupported platform: $(uname -s)" >&2
	exit 1
	;;
esac

if [ -d "$repo_dir/.git" ]; then
	echo "dotfiles already cloned at $repo_dir, pulling latest"
	git -C "$repo_dir" pull
else
	echo "Cloning dotfiles to $repo_dir"
	mkdir -p "$(dirname "$repo_dir")"
	git clone https://github.com/fatlard1993/dotfiles "$repo_dir"
fi

# The cd is load-bearing: dot-update's first act is `ln -sf $(pwd) ~/.dotfiles`,
# so running it from anywhere else aims ~/.dotfiles at the wrong directory and
# every $dotfilesPath lookup after that resolves into that tree instead.
cd "$repo_dir"
exec ./dot-update "$@"
