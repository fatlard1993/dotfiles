#!/bin/zsh

source "$HOME/.dotfiles/bin/lib/dot-util" "$0" "$@"

brew update

# brew update redirects this tap's remote (koekeishiya/formulae ->
# asmvik's fork, upstream's actual new home), which wipes the trust store
# entirely, not just this tap's entry - so trust has to be re-established
# every run, not once. Idempotent and free once it's already trusted.
brew trust --tap koekeishiya/formulae

(cd $dotfilesPath ; brew bundle)
(cd $macosPath ; brew bundle)
brew upgrade
