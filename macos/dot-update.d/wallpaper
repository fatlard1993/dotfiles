#!/bin/zsh

source "$HOME/.dotfiles/bin/lib/dot-util" "$0" "$@"

# The subreddit list is per-machine data ($profilePath/.wallpaper_subreddits);
# the linking logic is shared - profiles without the data file skip it.
[[ -f $profilePath/.wallpaper_subreddits ]] && {
	echo "Linking wallpaper config"

	mkdir -p $HOME/Pictures/Wallpapers
	ln -sf $profilePath/.wallpaper_subreddits $HOME/Pictures/Wallpapers/.subreddits

	# Ubuntu's login fetch comes from ubuntu/startup.d/wallpaper, which
	# bspwm's rc runs; macOS has no session-startup layer in this repo, so
	# launchd is what calls `wallpaper get` here - RunAtLoad for the login
	# fetch, StartCalendarInterval for the recurring one.
	#
	# Three small fetches a day rather than ubuntu's single `get 15`:
	# reddit 429s after a handful of requests in quick succession, and
	# `get`'s subreddit-cycling retry makes that worse, not better - it
	# bursts a fresh RSS fetch per remaining subreddit and gives up on the
	# first 429. Spacing the same daily volume out keeps each run under the
	# limit, and a throttled slot costs one fetch instead of the day's.
	installLaunchAgent com.justfatlard.wallpaper
}

# Per-Space rotation is native macOS Shuffle (System Settings > Wallpaper >
# pick the folder > Shuffle), configured once by hand per desktop - see
# macos/README.md's Wallpaper section for why. A Space's wallpaper only
# ever updates while that Space is actually focused, no matter how the
# change is made (direct edit, AppleScript, doesn't matter), so a script
# driving rotation can only ever flip visibly through every Space to do
# it - same cost as doing it by hand once and letting Shuffle own the
# timing from there.
