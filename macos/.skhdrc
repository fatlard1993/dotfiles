## $HOME/.skhdrc
# A list of all built-in modifier and literal keywords can be found at
# https://github.com/koekeishiya/skhd/issues/1

## KEYBINDS
#        Key        :        Command

# balance size of windows
alt + shift - 0     : yabai -m space --balance

# toggle window parent zoom
alt - b             : yabai -m window --toggle zoom-parent

# toggle window fullscreen zoom
alt + shift - f             : yabai -m window --toggle zoom-fullscreen

# toggle window native fullscreen
meh - f             : yabai -m window --toggle native-fullscreen

# float / unfloat window and restore position
alt - f             : yabai -m window --toggle float && yabai -m window --grid 4:4:1:1:2:2

# toggle picture-in-picture
alt - p             : yabai -m window --toggle border && yabai -m window --toggle pip

meh - 1             : yabai -m config focus_follows_mouse autoraise
meh - q             : yabai -m config focus_follows_mouse off

ctrl + alt - f      : yabai -m window --toggle topmost; yabai -m window --toggle zoom-fullscreen; yabai -m window --toggle topmost

# smart paste: dedent + reflow prose, then paste
meh - v       : $HOME/.dotfiles/bin/prose-paste

## Parity with ubuntu/.sxhkdrc's bspwm bindings - closing the gap between
## the two setups where yabai/skhd genuinely support the equivalent, per
## `man yabai` rather than assumption. Left out: anything that
## needs System Integrity Protection partially disabled (space
## --create/--destroy, window --scratchpad/--sticky/--raise/--lower) - see
## macos/README.md's Yabai section for why that's a deliberate line, not
## an oversight.

# focus window by direction (bspc node -f {west,south,north,east})
alt - left          : yabai -m window --focus west
alt - down          : yabai -m window --focus south
alt - up            : yabai -m window --focus north
alt - right         : yabai -m window --focus east

# swap window by direction (bspc node -s {west,south,north,east})
alt + shift - left  : yabai -m window --swap west
alt + shift - down  : yabai -m window --swap south
alt + shift - up    : yabai -m window --swap north
alt + shift - right : yabai -m window --swap east

# focus prev/next/last space (bspc desktop -f {prev,next}.local / last).
# skhd's key-literal list (github.com/koekeishiya/skhd/issues/1) has no
# "comma"/"period" name - only return/tab/space/backspace/escape/arrows/
# f-keys/media keys - so these are the raw ANSI virtual keycodes instead
# (kVK_ANSI_Comma/kVK_ANSI_Period).
alt - 0x2B          : yabai -m space --focus prev
alt - 0x2F          : yabai -m space --focus next
alt - tab           : yabai -m space --focus recent

# send the focused window to space N, keeping focus where it was (bspwm's
# super+ctrl+{1-9}) - cmd+{1-9} itself is the native macOS switch-to-desktop-N
# hotkey (macos-config.d/keyboard), so this stays off cmd entirely
ctrl + alt - 1      : yabai -m window --space 1
ctrl + alt - 2      : yabai -m window --space 2
ctrl + alt - 3      : yabai -m window --space 3
ctrl + alt - 4      : yabai -m window --space 4
ctrl + alt - 5      : yabai -m window --space 5
ctrl + alt - 6      : yabai -m window --space 6
ctrl + alt - 7      : yabai -m window --space 7
ctrl + alt - 8      : yabai -m window --space 8
ctrl + alt - 9      : yabai -m window --space 9

# rotate the space's tree (bspc node @/ -C {forward,backward})
ctrl + alt - right  : yabai -m space --rotate 90
ctrl + alt - left   : yabai -m space --rotate 270

# resize the focused window from each edge (bspwm's super+ctrl+s : awsd)
ctrl + alt - a      : yabai -m window --resize left:-20:0
ctrl + alt - w      : yabai -m window --resize top:0:-20
ctrl + alt - s      : yabai -m window --resize bottom:0:20
ctrl + alt - d      : yabai -m window --resize right:20:0

# toggle tiled/monocle layout (bspc desktop -l next) - yabai has no "next"
# for --layout, see bin/yabai-layout-toggle
alt - m             : $HOME/.dotfiles/macos/bin/yabai-layout-toggle

# swap the focused window with the biggest one (bspc node -s biggest.window)
alt - g             : yabai -m window --swap largest

# reload yabai + skhd (bspwm's super+ctrl+escape)
alt + shift - r     : yabai --restart-service; skhd --restart-service