#!/bin/zsh

###############################################################################
# Mission Control                                                             #
###############################################################################

# Speed up Mission Control animations - and the Space-switch swoosh
# specifically, which this key alone doesn't cover. Dropped to near-zero
# (from 0.1) so manually switching Spaces (there's no way to update a
# Space's wallpaper without actually visiting it - see macos/README.md's
# Wallpaper section) feels close to instant instead of a visible slide.
defaults write com.apple.dock expose-animation-duration -float 0.001
defaults write com.apple.dock workspaces-swoosh-animation-off -bool true

# Don’t group windows by application in Mission Control
# (i.e. use the old Exposé behavior instead)
defaults write com.apple.dock expose-group-by-app -bool false

# Keep Spaces in a fixed left-to-right order instead of reshuffling by most
# recent use - required for keyboard/keyboard's CMD+N switch-to-desktop-N
# hotkeys to keep pointing at the same desktop over time.
defaults write com.apple.dock mru-spaces -bool false