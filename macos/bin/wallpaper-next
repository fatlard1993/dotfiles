#!/opt/homebrew/bin/bash
# Assigns a fresh wallpaper to just the currently-focused Space. Thin wrapper
# over wallpaper-space, same role as ubuntu/bin/wallpaper-next.

[[ -d /opt/homebrew/opt/coreutils/libexec/gnubin ]] && PATH="/opt/homebrew/opt/coreutils/libexec/gnubin:$PATH"
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"

BIN_DIR="$HOME/.dotfiles/macos/bin"

space=$(yabai -m query --spaces --space 2>/dev/null | jq -r '.index // empty')

if [ -z "$space" ]; then
	echo "Could not determine the focused space" >&2

	exit 1
fi

exec "$BIN_DIR/wallpaper-space" "$space"
