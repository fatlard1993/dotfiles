#!/bin/bash
# The program-launcher chord's target, behind one level of profile dispatch:
# a machine whose front door isn't drun ships bin/launcher in its profile
# (ben_thickbook's desk) and this defers to it. Explicit, not PATH-shadowed -
# profile bin is deliberately appended to PATH (see .zshenv.d/path), so an
# override has to be named to be real.
#
# --full walks past that dispatch to drun itself - every app installed, not
# the curated set. It exists for the parent standing at a kid's seat with
# something to debug or reach around; super+alt+space, bound in .sxhkdrc.

if [ "$1" = --full ]; then
	# A desk already open holds the keyboard grab, and a rofi that can't
	# grab comes up dead rather than saying so.
	pkill -x rofi && sleep 0.2
else
	override="$HOME/.dotfiles/profiles/$(cat "$HOME/.dotfilesProfile" 2>/dev/null)/bin/launcher"
	[ -x "$override" ] && exec "$override"
fi

exec rofi -show drun -show-icons=true
