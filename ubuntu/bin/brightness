#!/bin/bash
# Usage: brightness screen up|down|<percent> [step_percent]
#        brightness kbd cycle
#
# Writes directly to the backlight sysfs nodes (video group has write access
# via profiles/tiny_lappy/dot-update.d/backlight-permissions - no pkexec
# prompt needed, since this gets called on every hotkey press).

target=$1
action=$2

screen_dirs=(/sys/class/backlight/*)
screen_file=${screen_dirs[0]}/brightness
screen_max=$(cat "${screen_dirs[0]}/max_brightness")

kbd_dirs=(/sys/class/leds/*::kbd_backlight)
kbd_file=${kbd_dirs[0]}/brightness
kbd_max=$(cat "${kbd_dirs[0]}/max_brightness" 2>/dev/null)

case "$target" in
screen)
	current=$(cat "$screen_file")
	step_pct=${3:-10}
	step=$((screen_max * step_pct / 100))

	case "$action" in
	up)
		new=$((current + step))
		;;
	down)
		new=$((current - step))
		;;
	*)
		new=$(( action * screen_max / 100 ))
		;;
	esac

	[ "$new" -gt "$screen_max" ] && new=$screen_max
	[ "$new" -lt 0 ] && new=0

	echo "$new" 2>/dev/null > "$screen_file" || {
		notify-send -u critical "Screen Brightness" "Can't write $screen_file - is $USER in the video group?"
		exit 1
	}

	pct=$((new * 100 / screen_max))
	notify-send -h int:value:"$pct" -h string:x-canonical-private-synchronous:brightness "Screen Brightness" "${pct}%"
	;;
kbd)
	current=$(cat "$kbd_file")
	new=$(( (current + 1) % (kbd_max + 1) ))

	echo "$new" 2>/dev/null > "$kbd_file" || {
		notify-send -u critical "Keyboard Backlight" "Can't write $kbd_file - is $USER in the video group?"
		exit 1
	}

	notify-send "Keyboard Backlight" "Level ${new}/${kbd_max}"
	;;
esac
