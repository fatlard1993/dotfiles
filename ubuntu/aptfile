#!/usr/bin/env aptfile

update

package "build-essential"
package "software-properties-common"
package "curl"
package "bzip2"
package "dnsmasq"
package "whois"
package "make"
package "autoconf"
package "automake"
package "speedtest-cli"
package "openssh-server"
package "arp-scan"
package "yt-dlp"
package "cu"
package "net-tools"
package "uuid-runtime"
package "gparted"
package "pv"
package "python3-dev"
package "python3-pip"
package "python3-setuptools"
package "libusb-1.0-0-dev"
package "plocate"

# ipptool and ippfind, which bin/printer-status talks to the printer with.
# Same trap as python3-pil below: they were only ever here as something else's
# dependency, so the bar module would have silently reported "no printer" on
# any machine that happened not to pull them in.
package "cups-ipp-utils"

package "xinit"
package "xserver-xorg"
package "pasystray"
package "default-jre"
package "nautilus"
package "libinput-tools"
package "pavucontrol"
package "xclip"
package "trash-cli"
package "xinput"
package "xautolock"
package "xss-lock"
package "wmctrl"
package "xdotool"
package "python3-xlib"
package "scrot"
package "feh"
package "imagemagick"
# lock-tick's HUD tick: rsvg-convert rasterizes the layer, Pillow composites
# it. Neither is pulled in by anything else here - Pillow only ever arrived
# as an hplip dependency, and machines without a printer stack got a lock
# screen with no graphics at all.
package "librsvg2-bin"
package "python3-pil"
package "tesseract-ocr"
package "libcanberra-gtk3-module"
package "ffmpeg"
package "kitty"
package "rofi"
package "sxhkd"
package "bspwm"
package "polybar"
package "mousepad"
package "picom"
package "dunst"
package "yaru-theme-gtk"
package "yaru-theme-icon"
package "adwaita-icon-theme"
package "autorandr"
package "fontconfig"

echo "Upgrading apt packages"

apt update --fix-missing

dpkg --configure -a

apt upgrade -y

apt install --fix-broken -y


echo "Cleaning apt packages"

apt upgrade -y

apt autoremove --purge -y

apt clean