#!/bin/zsh

[[ ! -a  $HOME/.local/bin/aptfile ]] && {
	echo "Installing aptfile"

	mkdir -p $HOME/.local/bin

  curl -o $HOME/.local/bin/aptfile https://raw.githubusercontent.com/seatgeek/bash-aptfile/master/bin/aptfile

	chmod +x $HOME/.local/bin/aptfile
}

echo "Installing ubuntu apps"

# PATH rides along for the `#!/usr/bin/env aptfile` shebang: on a first run
# sudo still enforces secure_path (the sudo step that relaxes it sorts after
# this one), so root can't see ~/.local/bin unless env hands it over.
sudo env DEBIAN_FRONTEND=noninteractive PATH="$HOME/.local/bin:$PATH" $HOME/.dotfiles/ubuntu/aptfile

echo "Autoinstalling drivers"

sudo ubuntu-drivers install
