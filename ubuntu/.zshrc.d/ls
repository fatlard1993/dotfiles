#!/bin/zsh

# ls defaults
#
# Overriding the shared .zshrc.d/ls is the point, not a collision: that one
# calls gls, which only exists on macOS (brew coreutils). ubuntu/.zshrc.d is
# sourced after the shared set, so this lands last and wins.
#
# =auto, not a bare --color: bare means "always" in GNU ls, which colors right
# through a pipe. Anything parsing `ls` output then gets escape codes glued to
# the filenames and silently fails to match. NO_COLOR=1 (.zshenv.d/claude) does
# not save you here - an explicit --color flag outranks it; only =auto defers.
alias ls="command ls --color=auto"
