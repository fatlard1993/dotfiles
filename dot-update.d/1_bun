#!/bin/zsh

source "$HOME/.dotfiles/bin/lib/dot-util" "$0" "$@"

# bun, which ender-launcher and the home page's favicon fetcher are written against.
#
# From bun's own installer rather than the Brewfile: Homebrew refuses a third-party tap
# until it is trusted, so `brew "oven-sh/bun/bun"` printed a refusal and installed nothing
# - and .zshrc.d/bun puts $HOME/.bun/bin first on PATH, so brew's copy would have been
# shadowed even where the tap was trusted.
#
# A floor rather than the newest. ender-launcher's lockfile is lockfileVersion 2, which a
# bun below this cannot read: it fails the install, writes its own lockfile back, and
# leaves the clone modified so every later --ff-only pull refuses. `bun upgrade` every run
# answered that by moving all seven machines onto whatever shipped that day, unattended.
# Raise this when the lockfile needs a newer bun, not before.
bunFloor=1.4.0

autoload -Uz is-at-least

bunInstall() {
	local script=$(mktemp)

	# bun's installer unpacks a zip and refuses without unzip. Ensured here rather than
	# declared in a profile's aptfile, because those run from 3_profile - after this hook -
	# so a machine that needed it would fail before the declaration was ever read. A minimal
	# server is where this bites: the desktop profiles have had unzip for years.
	if ! command -v unzip > /dev/null 2>&1; then
		echo "  Installing unzip, which bun's installer needs"

		if command -v apt-get > /dev/null 2>&1; then
			sudo apt-get install -y -qq unzip > /dev/null 2>&1 || true
		elif command -v brew > /dev/null 2>&1; then
			brew install --quiet unzip > /dev/null 2>&1 || true
		fi

		command -v unzip > /dev/null 2>&1 || {
			echo "  unzip is still missing, so bun cannot be installed" >&2

			command rm -f $script

			return 1
		}
	fi

	# Downloaded, then run: zsh takes a pipeline's status from its last command and pipefail
	# is not set here, so `curl ... | bash || echo` reported success with curl failing and
	# nothing installed. That was the only error path this file had.
	if ! curl -fsSL https://bun.sh/install -o $script; then
		echo "  bun could not be downloaded, so ender-launcher cannot be installed" >&2

		command rm -f $script

		return 1
	fi

	bash $script > /dev/null 2>&1 || {
		echo "  bun's installer ran but failed" >&2

		command rm -f $script

		return 1
	}

	command rm -f $script
}

if ! command -v bun > /dev/null 2>&1; then
	echo "Installing bun"

	bunInstall || return 1

	# Sourced after the install and outside its branch, because .zshrc.d/nvm carries an
	# eight-line comment about the run where doing this conditionally was the bug, and this
	# file was modelled on that one.
	command -v bun > /dev/null 2>&1 || source "$dotfilesPath/.zshrc.d/bun"
fi

if ! is-at-least $bunFloor $(bun --version 2>/dev/null); then
	echo "Upgrading bun ($(bun --version) is below the $bunFloor ender-launcher's lockfile needs)"

	bun upgrade > /dev/null 2>&1 || echo "  bun would not upgrade, so it stays at $(bun --version)" >&2
fi
