#!/bin/zsh

source "$HOME/.dotfiles/bin/lib/dot-util" "$0" "$@"

# Games built in paude's arcade here are hosted by paude's own copy of web-game-mother-hub, as bun-server@<name> user
# units from ~/Projects/<name>; opened to the internet, Caddy serves them on its slots (dot-update.d/caddy). This makes
# the template unit theirs and keeps the units alive past logout; the hub does the rest, per game.

ensureBun

echo "Linking bun-server@ template unit"

mkdir -p $HOME/.config/systemd/user
ln -sf $profilePath/systemd/bun-server@.service $HOME/.config/systemd/user/
systemctl --user daemon-reload

ensureLinger
