#!/bin/zsh

source "$HOME/.dotfiles/bin/lib/dot-util" "$0" "$@"

# The command-line half of a dev machine: the Brewfile's tools are what the claude tool-shelf points sessions at.
# The rest of the ubuntu layer is a desktop (xorg, bspwm, polybar), which this headless box has no use for.
$ubuntuPath/dot-update.d/homebrew
