#/etc/default/grub
# If you change this file, run 'update-grub2' afterwards

GRUB_DEFAULT=0
GRUB_TIMEOUT=1
GRUB_DISTRIBUTOR=`lsb_release -i -s 2> /dev/null || echo Debian`
# video= pins HDMI-A-1 permanently on so output never depends on the Denon's
# hotplug/EDID answering - booting while the receiver is off or on another
# input otherwise comes up headless. 1080p60 is the blind-safe mode (4K60
# needs SCDC negotiation, which needs a live DDC line); X upgrades to 4K60
# via autorandr whenever the EDID actually reads.
#
# The trailing flag is `e` alone, never `De`. drm_mode_parse_cmdline_extra()
# rejects a second force flag (each of d/D/e returns -EINVAL if force is
# already set), and a rejected mode string is dropped whole - so `@60De`
# boots exactly as if no video= were here at all, silently. `D` only differs
# from `e` on DVI-I/HDMI-B, which this connector is not.
GRUB_CMDLINE_LINUX_DEFAULT="net.ifnames=0 biosdevname=0 text video=HDMI-A-1:1920x1080@60e"
GRUB_CMDLINE_LINUX=""

GRUB_TERMINAL=console
