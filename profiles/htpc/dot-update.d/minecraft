#!/bin/zsh

source "$HOME/.dotfiles/bin/lib/dot-util" "$0" "$@"
source "$HOME/.dotfiles/bin/lib/minecraft"

# The house Fabric server and the couch client, both on the suite pin from
# bin/lib/minecraft. Mod jars are not managed here: they arrive from the dev machine, so
# nothing runs a jar that did not come out of a green suite build.
mcDir=$HOME/minecraft-server

mcEnsureEnder || return 1

mcEnsureInstance suite-server $mcSuiteVersion fabric $mcDir server $mcSuiteLoaderVersion || {
	echo "  The suite-server instance could not be set up" >&2

	return 1
}

# Captured now rather than read later: mcEnsurePlayerClient sets the same variable for the
# couch client below, and the restart branch would then answer for the wrong instance.
serverPinMoved=$mcInstanceChanged

ender server provision suite-server > /dev/null || echo "  suite-server could not be provisioned" >&2

# The modded suite earns more heap than vanilla did. Set on the instance rather than in the
# unit: it belongs to the server, not to how systemd starts it.
for setting in memory.min=2048 memory.max=6144; do
	ender set ${setting%%=*} ${setting##*=} --instance suite-server > /dev/null \
		|| echo "  suite-server kept its old ${setting%%=*}, so it may run short of heap" >&2
done

# The server refuses to start until Mojang's EULA (aka.ms/MinecraftEULA) is accepted;
# setting up an auto-running server implies accepting it.
[[ -f $mcDir/eula.txt ]] || echo "eula=true" > $mcDir/eula.txt

echo "Linking minecraft server service"

mkdir -p $HOME/.config/systemd/user
ln -sf $profilePath/systemd/minecraft-server.service $HOME/.config/systemd/user/
systemctl --user daemon-reload

# the server shouldn't die because the couch session logged out
ensureLinger

# Retired: the suite server runs on the rented box now (the vps ssh host), and this one
# stays stopped as a fallback with its world in place. The marker is the switch, so
# bringing it back is deleting a file rather than editing this script.
if [[ -e $mcDir/.retired ]]; then
	echo "Minecraft server retired here (\$mcDir/.retired); not starting it"
elif systemctl --user is-active --quiet minecraft-server.service; then
	if (( serverPinMoved )); then
		echo "Restarting minecraft server for $mcSuiteVersion"

		systemctl --user restart minecraft-server.service
	fi
else
	echo "Starting minecraft server"

	systemctl --user enable --now minecraft-server.service
fi

# The couch client. This box is played from a controller, and a launcher GUI is a
# mouse-only wall in front of the game; ender takes --server directly, so the launch line
# in this profile's minecraft-couch is all Steam needs.
clientDir=$HOME/minecraft-client

mcAdoptPrismGameDir suite $clientDir || return 1

mcEnsurePlayerClient $mcSuiteVersion fabric $clientDir couch $mcSuiteLoaderVersion || return 1

# The couch client gets a real heap, and one that does not grow into it. ender's default is
# -Xms512M -Xmx4096M, and a 53-mod client measured 2.87G resident against that ceiling -
# so it spent the whole way up doing full collections it did not need to. Equal min and max
# removes the resizing entirely. This box has 15G and nothing else competing for it.
for setting in memory.min=6144 memory.max=6144; do
	ender set ${setting%%=*} ${setting##*=} --instance couch > /dev/null \
		|| echo "  couch kept its old ${setting%%=*}, so it may stutter collecting" >&2
done

# Two options the hardware decides rather than the player.
#
# fullscreen, because under 26.3 the game applies its saved "fullscreen:false" after the
# window is up, which undoes the window manager's rule and leaves the game tiled under the
# status bar.
#
# Not fullscreenResolution, on purpose. The projector is 3840x2160 and the GPU is a Polaris
# RX 580, so fullscreen with no resolution named asks the card for 8.3 megapixels a frame -
# measured at 100% busy on its peaks. Naming 1920x1080@60:24 here is a quarter of the pixels
# and the projector scales it back, which at throw distance nobody can see.
#
# Sodium is the better answer to the same bottleneck, since it replaces the renderer rather
# than giving up resolution, and it has a 26.3 release now. So the pixels stay until that is
# measured. If 4K still stutters with Sodium loaded, add fullscreenResolution:1920x1080@60:24
# to the loop below - a mode the display does not offer is ignored and the game falls back to
# the desktop one, so a wrong value cannot make the screen unusable.
#
# Left alone while the game is open, because it rewrites this file from memory on exit -
# an edit made underneath a running game is an edit thrown away.
mcOptions=$clientDir/options.txt
if mcGameRunning $clientDir; then
	echo "  The game is open, so its options are left as they are. Run this again after."
else
	mkdir -p ${mcOptions:h}
	touch $mcOptions

	for option in fullscreen:true; do
		if grep -q "^${option%%:*}:" $mcOptions; then
			sed -i "s|^${option%%:*}:.*|$option|" $mcOptions
		else
			echo $option >> $mcOptions
		fi
	done
fi
