#!/bin/zsh

source "$HOME/.dotfiles/bin/lib/dot-util" "$0" "$@"
source "$HOME/.dotfiles/bin/lib/minecraft"

# The house Fabric server AND the couch client, both running the mod suite
# (~/Projects/minecraft on the dev laptop). Game + loader versions are
# pinned to what the suite builds against - bump them here in the same
# breath as the suite's gradle.properties, never independently: the world
# and every mod jar move with the suite, not with Mojang's release channel.
# The two halves read the same two variables, so a client that can't join
# this box's server is not a state this file can produce. The required Java
# still comes from Mojang's manifest for the pinned version. Mod jars are
# NOT managed here - they deploy from the suite workspace (build-all.sh,
# then scp) so nothing ever runs a jar that didn't come out of a green
# suite build.
mcVersion=26.3-rc-1
loaderVersion=0.19.5
installerVersion=1.1.2

mcDir=$HOME/minecraft-server
mcEnsureEnder || return 1

# The server, described rather than assembled. What stood here was a manifest fetch to
# learn which JRE the pin wanted, an apt install of it, and a loader jar fetched by hand
# behind a .version marker. ender reads the pin itself, fetches the runtime the version
# asks for, and provisions the loader's own server launcher.
mcEnsureInstance suite-server $mcVersion fabric $mcDir server
serverPinMoved=$?

(( serverPinMoved == 1 )) && {
	echo "  The server instance could not be set up" >&2

	return 1
}

ender server provision suite-server > /dev/null || echo "  The server could not be provisioned"

# The modded suite (37 mods plus worldgen) earns more heap than vanilla did. Set on the
# instance rather than in the unit: it belongs to the server, not to how systemd starts
# it. Tune it if worlds grow or Steam needs the RAM back.
ender set memory.min 2048 --instance suite-server > /dev/null
ender set memory.max 6144 --instance suite-server > /dev/null

# The server refuses to start until Mojang's EULA (aka.ms/MinecraftEULA)
# is accepted; setting up an auto-running server implies accepting it.
[[ -f $mcDir/eula.txt ]] || echo "eula=true" > $mcDir/eula.txt

echo "Linking minecraft server service"

mkdir -p $HOME/.config/systemd/user
ln -sf $profilePath/systemd/minecraft-server.service $HOME/.config/systemd/user/
systemctl --user daemon-reload

# the server shouldn't die because the couch session logged out
ensureLinger

# Retired: the suite server moved to the rented box (see edge/ and the vps ssh host), and
# this one stays stopped as a fallback with its world in place. The marker is the switch,
# so bringing it back is deleting a file rather than editing this script.
if [[ -e $mcDir/.retired ]]; then
	echo "Minecraft server retired here (\$mcDir/.retired); not starting it"
elif systemctl --user is-active --quiet minecraft-server.service; then
	if (( serverPinMoved == 2 )); then
		echo "Restarting minecraft server for $mcVersion"

		systemctl --user restart minecraft-server.service
	fi
else
	echo "Starting minecraft server"

	systemctl --user enable --now minecraft-server.service
fi

# The couch client.
#
# This box is played from a controller, and every launcher is a mouse-only wall in front
# of the game: a launcher GUI, a title screen and a server list, three screens a gamepad
# navigates badly. Prism was installed here for one thing, --launch with --server, which
# skipped all three. ender takes --server directly, so the wall is gone and the second
# launcher with it. The launch line lives in this profile's minecraft-couch, which is
# what Steam points at.
#
# The client used to live inside Prism's instance folder, which is where the worlds and
# the options are, so it is moved out once before anything else looks for it.
clientDir=$HOME/minecraft-client

mcAdoptPrismGameDir suite $clientDir

mcEnsurePlayerClient $mcVersion fabric $clientDir couch

# Fullscreen from the game's own options as well as from the window manager's
# rule. Under 26.3-rc-1 the game applies its saved "fullscreen:false" after the
# window is up, which undoes the rule's fullscreen and leaves the game tiled
# under the status bar. Left alone while the game is open: it writes this file
# from memory and would put its own value back.
mcOptions=$clientDir/options.txt
if mcGameRunning $clientDir; then
	echo "  The game is open, so fullscreen is left as it is. Run this again after."
elif [[ -f $mcOptions ]]; then
	grep -q '^fullscreen:' $mcOptions \
		&& sed -i 's/^fullscreen:.*/fullscreen:true/' $mcOptions \
		|| echo 'fullscreen:true' >> $mcOptions
else
	mkdir -p ${mcOptions:h}
	echo 'fullscreen:true' > $mcOptions
fi
