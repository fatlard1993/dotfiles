#!/bin/zsh

source "$HOME/.dotfiles/bin/lib/dot-util" "$0" "$@"

# web-game-mother-hub, the page that turns the house's games on and off, updates and resets them, and opens one to the
# internet through the vps for a game night (https://hub.home, from dot-update.d/lan-names). It runs as one more
# bun-server@ instance, the template game-servers links (and runs before this), and drives the games' own bun-server@
# units. Its settings - the password and the vps - are priv-config's: ~/.config/web-game-mother-hub.env.

ensureBun
ensureLinger

hub=$HOME/Projects/web-game-mother-hub
fresh=false
[[ -d $hub ]] || fresh=true

syncRepo https://github.com/fatlard1993/web-game-mother-hub.git $hub

# --frozen-lockfile for the same reason as the games: a rewritten bun.lock blocks the next pull
(cd $hub ; bun install --frozen-lockfile)

# The leading - lets it start without the file, printing a password of its own once to its journal
unit=$HOME/.config/systemd/user/bun-server@web-game-mother-hub.service.d
mkdir -p $unit
printf '[Service]\nEnvironmentFile=-%%h/.config/web-game-mother-hub.env\n' > $unit/env.conf
systemctl --user daemon-reload

if [[ $fresh == true ]] || ! systemctl --user is-active --quiet bun-server@web-game-mother-hub.service; then
	echo "Starting web-game-mother-hub"

	systemctl --user enable --now bun-server@web-game-mother-hub.service
elif [[ $repoUpdated == true ]]; then
	echo "Restarting web-game-mother-hub (updated)"

	systemctl --user restart bun-server@web-game-mother-hub.service
fi
