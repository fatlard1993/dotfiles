#!/bin/zsh

source "$HOME/.dotfiles/bin/lib/dot-util" "$0" "$@"

# Self-hosted game servers for the house (humanity :8032, void-driller
# :1040, sorcery-and-savagery :3040, game-night :8034 - no collisions with
# htpc-remote :8793 or land-ledger :7450). All the same shape: bun apps
# whose `prepare` script builds the client during install, run by the shared
# bun-server@ template unit (see systemd/bun-server@.service). Once installed,
# they're turned on and off, updated and reset from web-game-mother-hub
# (https://hub.home, dot-update.d/mother-hub), which also lists the games
# bin/shelf-game puts on the shelf.

ensureBun

echo "Linking bun-server@ template unit"

mkdir -p $HOME/.config/systemd/user
ln -sf $profilePath/systemd/bun-server@.service $HOME/.config/systemd/user/
systemctl --user daemon-reload

# the servers shouldn't depend on the couch session being logged in
ensureLinger

# The games (except game-night, which stands alone) share one engine,
# web-game-framework, each pinning a commit of it from GitHub in its own
# package.json, so their installs fetch it themselves: no sibling checkout to
# keep here.

# Adding a game? Give it a *.home name + port in dot-update.d/lan-names too.
for game in humanity void-driller sorcery-and-savagery game-night; do
	fresh=false
	[[ -d $HOME/Projects/$game ]] || fresh=true

	syncRepo https://github.com/fatlard1993/$game.git $HOME/Projects/$game

	# bun install runs each game's `prepare` (client build) as a side effect.
	# --frozen-lockfile: a plain install rewrites bun.lock whenever the
	# framework drifts ahead of the game's lockfile, and that dirty file
	# blocks every future pull. Frozen fails loudly instead - the fix is
	# regenerating the lockfile in the game's repo, never on the htpc.
	(cd $HOME/Projects/$game ; bun install --frozen-lockfile)

	# Started when it's first installed; after that, on and off are
	# web-game-mother-hub's (dot-update.d/mother-hub), so a game turned off
	# there stays off through the next dot-update
	if [[ $fresh == true ]]; then
		echo "Starting $game"

		systemctl --user enable --now bun-server@$game.service
	elif [[ $repoUpdated == true ]] && systemctl --user is-active --quiet bun-server@$game.service; then
		echo "Restarting $game (updated)"

		systemctl --user restart bun-server@$game.service
	fi
done
