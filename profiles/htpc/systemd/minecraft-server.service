# Linked into ~/.config/systemd/user by dot-update.d/minecraft, which also
# owns version updates and enables lingering so this runs from boot and
# survives logout, no login session required.
[Unit]
Description=Fabric Minecraft server (mod suite, managed by dot-update.d/minecraft)
After=network-online.target

[Service]
WorkingDirectory=%h/minecraft-server
# /usr/bin/java is update-alternatives' pick, i.e. the newest installed
# JDK - dot-update.d/minecraft installs whichever major version the pinned
# Minecraft version declares it needs, so this stays correct across
# updates. Heap: the modded suite (37 mods + worldgen) earns more than
# vanilla did; tune it if worlds grow or Steam needs the RAM back.
ExecStart=/usr/bin/java -Xms2G -Xmx6G -jar fabric-server.jar nogui
# The server saves and exits cleanly on SIGTERM (systemd's default stop
# signal); java reports that as 143 (128+15), which is still a clean stop.
# Restart=always because a hard crash can exit 0 (the JVM dies after the
# crash report writes cleanly); use systemctl stop for a deliberate stop.
SuccessExitStatus=0 143
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
