# Sunday morning, after the VPS's nightly 04:30 backup has had time to finish.
# Persistent=true catches up a week the box spent off.
[Unit]
Description=Weekly pull of the VPS Minecraft world backup

[Timer]
OnCalendar=Sun 06:00
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
