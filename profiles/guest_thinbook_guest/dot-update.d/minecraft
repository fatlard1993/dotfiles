#!/bin/zsh

source "$HOME/.dotfiles/bin/lib/dot-util" "$0" "$@"
source "$HOME/.dotfiles/bin/lib/minecraft"

# The guest seat on the shared thinkpad. No aptfile on this profile: the kid seat's
# profile installs the system packages, and two user accounts on one machine do not each
# need a copy. ender is per-user though - it links into ~/.bun/bin - so this seat clones
# and links its own.
mcAdoptPrismGameDir suite $HOME/minecraft-suite || return 1

mcEnsurePlayerClient $mcSuiteVersion fabric $HOME/minecraft-suite suite $mcSuiteLoaderVersion || return 1
