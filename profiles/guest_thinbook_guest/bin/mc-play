#!/bin/zsh
# Launch the suite client straight into the house server.
#
#   mc-play          join the house server
#   mc-play --menu   stop at the title screen (singleplayer, or a settings run)
#
# The instance is built by dot-update.d/minecraft and pinned to the same game and
# loader the household server runs.

source "$HOME/.dotfiles/bin/lib/minecraft"

# An array, not ${server:+--server $server}: zsh does not word-split an unquoted
# expansion, so that form hands over one argument reading "server <address>". An empty
# array disappears from the line instead, which is what --menu wants.
#
# No fallback: an address that is not serving is worse than none, because the launch goes
# past the title screen and fails to connect without saying why.
suiteServer=$(mcServerAddress)
joinServer=()

[[ -n $suiteServer ]] && joinServer=(--server $suiteServer)

[[ $1 == --menu ]] && joinServer=()

# This runs from a desktop button, where a quiet exit is indistinguishable from doing
# nothing. notify-send's own failure is ignored: stderr still reaches the journal.
command -v ender > /dev/null 2>&1 || {
	notify-send "Minecraft" "ender is not set up on this machine yet. Run dot-update." 2>/dev/null
	echo "ender is not installed - dot-update.d/minecraft clones and links it" >&2

	exit 1
}

ender ls --names 2>/dev/null | grep -qxF suite || {
	notify-send "Minecraft" "The suite instance is not set up on this machine yet. Run dot-update." 2>/dev/null
	echo "no 'suite' instance - see dot-update.d/minecraft" >&2

	exit 1
}

# Who plays is picked here, every launch: this is a shared seat, and a name is the whole
# identity on an offline-mode server. The list is ender's own accounts plus an entry that
# adds one. Dismissing either prompt cancels the launch rather than guessing a name.
newProfile="+ New profile..."

while true; do
	choice=$( { ender account --names 2>/dev/null; print -r -- $newProfile } | rofi -dmenu -i -p "Play as" ) || exit 0
	[[ -n $choice ]] || exit 0

	if [[ $choice != $newProfile ]]; then
		ender account use $choice > /dev/null 2>&1 || {
			notify-send "Minecraft" "Could not switch to $choice" 2>/dev/null

			exit 1
		}

		break
	fi

	name=$(rofi -dmenu -p "New profile name" -mesg "3-16 letters, numbers or _" < /dev/null) || continue
	[[ -n $name ]] || continue

	if [[ ! $name =~ ^[A-Za-z0-9_]{3,16}$ ]]; then
		notify-send "Minecraft" "\"$name\" is not a usable name: 3-16 letters, numbers or _" 2>/dev/null

		continue
	fi

	# An existing name is just chosen, not added twice
	ender account --names 2>/dev/null | grep -qxF -- $name || ender account add --offline $name > /dev/null 2>&1 || {
		notify-send "Minecraft" "Could not add $name" 2>/dev/null

		continue
	}

	ender account use $name > /dev/null 2>&1 && break
done

# --update: the house pack is read again first, so a client is never a release behind it
exec ender launch suite --update $joinServer
