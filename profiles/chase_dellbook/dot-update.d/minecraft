#!/bin/zsh

source "$HOME/.dotfiles/bin/lib/dot-util" "$0" "$@"
source "$HOME/.dotfiles/bin/lib/minecraft"

# Minecraft client only - this is a laptop, not an always-on box, so unlike
# htpc/dot-update.d/minecraft there's no bundled server/systemd unit here.
# To play multiplayer against the household server, connect to the htpc.

# The suite's own client and server (~/Projects/minecraft).
#
# Versions are read from pandorical's gradle.properties rather than pinned
# here - pandorical is the platform every other mod depends on, so its pin is
# the suite's real target. This intentionally does NOT float forward on its
# own: a snapshot this specific is a compatibility target the mods were built
# against, not a version to track.
#
# mc-meta (profiles/chase_dellbook/bin) reports when upstream has moved past the
# pin. Reporting only - moving the pin means rebuilding forty jars and taking
# the household server down with it, which is a decision, not an update step.
suiteProps="$HOME/Projects/minecraft/pandorical/gradle.properties"

# The suite itself. Everything below is downstream of it, and until now nothing
# fetched it: a cold machine ran this file, printed "pandorical not found", and
# skipped the client, the server and the mods. What it ended up with was a
# launcher, Prism, an instance, and nothing to play - the one-stop-shop promise
# broken at exactly the step that mattered. The 42 repos were cloned by hand.
#
# Membership is a GitHub topic rather than a list kept in this repo, because a
# list is a thing to forget: a mod started next month joins by being tagged, and
# every machine picks it up on its next update. The account carries 114 repos and
# the topic is the only thing that separates the suite from the rest of them.
#
# Missing clones only - existing ones are left alone. These are working trees
# with uncommitted work in them as often as not, and a dot-update that pulled
# forty repos underneath you would be a maintenance step nobody could trust.
suiteTopic="minecraft-mod-suite"
suiteOwner=$(git config --global github.user)

if [[ -z $suiteOwner ]]; then
	echo "  No git github.user, so the suite cannot be located (priv-config git.config sets it)"
else
	mkdir -p $HOME/Projects/minecraft

	# gh when it is logged in, the public search API when it is not. Nothing
	# else here needs gh signed in: priv-config is cloned over ssh with the key
	# priv-config itself manages, so a machine can be fully set up with gh
	# never authenticated - which is exactly what the new laptop was, and the
	# first version of this block refused to clone anything on it.
	#
	# The mods are public repos, so the unauthenticated query answers fine. It
	# is rate limited at ten searches a minute, which one run of dot-update is
	# in no danger of.
	#
	# --limit / per_page are not optional: gh pages at 30 and the API at 30,
	# which would have quietly fetched the first thirty and left the rest to
	# turn up later as compile errors.
	if command -v gh > /dev/null && gh auth status > /dev/null 2>&1; then
		suiteRepos=(${(f)"$(gh repo list $suiteOwner --topic $suiteTopic --limit 200 --json name --jq '.[].name' 2>/dev/null)"})
	else
		suiteJson=$(curl -sf "https://api.github.com/search/repositories?q=user:$suiteOwner+topic:$suiteTopic&per_page=100" 2>/dev/null)
		suiteRepos=(${(f)"$(print -r -- $suiteJson | jq -r '.items[].name' 2>/dev/null)"})

		# The API reports how many it matched separately from how many it
		# returned; a suite that outgrows one page should say so rather than
		# silently clone the first hundred.
		suiteTotal=$(print -r -- $suiteJson | jq -r '.total_count // 0' 2>/dev/null)
		(( suiteTotal > ${#suiteRepos} )) && echo "  $suiteTotal repos carry the topic but only ${#suiteRepos} fit one page - this needs paginating"
	fi

	if (( ${#suiteRepos} == 0 )); then
		echo "  No repos carry the $suiteTopic topic - nothing to clone"
	else
		cloned=0
		for repo in $suiteRepos; do
			[[ -d $HOME/Projects/minecraft/$repo/.git ]] && continue

			echo "Cloning $repo into the suite"

			# https, not ssh: a cold machine has no key on GitHub yet, and this
			# is the same reason dot-update.d/slock clones over https.
			git -C $HOME/Projects/minecraft clone -q https://github.com/$suiteOwner/$repo && cloned=$((cloned + 1))
		done

		(( cloned > 0 )) && echo "  cloned $cloned of ${#suiteRepos} suite repo(s)"
	fi
fi

if [[ -f $suiteProps ]]; then
	mcVersion=$(grep -oP '(?<=^minecraft_version = ).*' $suiteProps)
	loaderVersion=$(grep -oP '(?<=^loader_version = ).*' $suiteProps)
	clientDir="$HOME/Projects/minecraft-client"
	serverDir="$HOME/Projects/minecraft-server"

	# The suite's pin and the fleet's must agree. bin/lib/minecraft declares what every
	# other machine builds an instance for; this file reads what the suite is actually
	# compiled against. They drifted once - pandorical moved to 26.3 while five profiles
	# stayed on 26.3-rc-1 under a comment saying they were copies of it - and nothing said
	# so, so the next bump is a check rather than six hand edits.
	if [[ $mcVersion != $mcSuiteVersion ]]; then
		echo "  The suite builds against $mcVersion but the fleet pin is $mcSuiteVersion." >&2
		echo "  Bump mcSuiteVersion in bin/lib/minecraft, or the house cannot join what you build." >&2
	fi

	# And against the server itself, which is the pin that actually decides whether anyone
	# can join. It runs on the rented box with no configuration management, so asking it is
	# the only way to know - reading the jar's filename says 26.3-rc-1 for a server that has
	# been on 26.3 since it was fetched. Advisory: a server that is down is not a failure of
	# this run.
	if command -v mc-server-version > /dev/null; then
		serverVersion=$(mc-server-version 2>/dev/null)

		if [[ -n $serverVersion && $serverVersion != $mcSuiteVersion ]]; then
			echo "  The house server reports $serverVersion but the fleet pin is $mcSuiteVersion," >&2
			echo "  so a client on this pin cannot join it." >&2
		fi
	fi

	# A compiler is not a runtime: default-jre ships no javac, and gradle turns that down
	# with "does not provide the required capabilities: [JAVA_COMPILER]".
	if ! command -v javac > /dev/null 2>&1; then
		echo "  No javac, so the suite cannot be built here (openjdk-25-jdk, this profile's aptfile)"
	elif pgrep -f GradleDaemon > /dev/null 2>&1; then
		# A gradle daemon caches its toolchain scan for its whole lifetime, so a daemon
		# started before 1_apt installed the JDK still reports no compiler - with the same
		# message a genuinely missing JDK gives. Left alone mid-build: gradle does not
		# document what --stop does to a busy daemon. -Dorg.gradle.appname is the wrapper,
		# which exists only for the length of a build.
		if pgrep -f "org.gradle.appname" > /dev/null 2>&1; then
			echo "  Gradle is mid-build, so its daemons are left alone (rerun after it finishes"
			echo "  if a build then reports no JAVA_COMPILER)"
		else
			echo "Stopping gradle daemons (they cache the toolchain scan across a JDK install)"

			(cd $HOME/Projects/minecraft/pandorical && ./gradlew --stop > /dev/null 2>&1) || true
		fi
	fi

	mcEnsureEnder || return 1

	mcEnsureInstance suite $mcVersion fabric $clientDir '' $loaderVersion || {
		echo "  The suite instance could not be set up" >&2

		return 1
	}

	# The curated list, not every project on disk: most of the suite is loadable in a client
	# but belongs only in a server, and shipping all of it has crashed one before.
	clientMods=(${(f)"$(mcClientMods)"})

	if (( ${#clientMods} )); then
		echo "Deploying ${#clientMods} client mod(s)"

		ender add $clientMods --instance suite > /dev/null || echo "  Some mods would not deploy - ender sync -i suite says which"
	else
		echo "  No client mod list (priv-config/minecraft/client-mods.txt), so none were deployed"
	fi

	# Optional: the house server runs offline-mode, so a machine with no client id still
	# plays. With one, this is the account the game uses.
	clientId=$(mcClientId) && { ender config clientId $clientId > /dev/null || echo "  The client id would not apply" >&2 }

	# A local server to test against without taking the household one down.
	if mcEnsureInstance suite-server $mcVersion fabric $serverDir server $loaderVersion; then
		ender server provision suite-server > /dev/null || echo "  The local server could not be provisioned" >&2

		# Said every run, not left to provision: provision seeds online-mode=false only when
		# there is no server.properties yet, and this one already had it set true - so the
		# offline client on this same machine could not reach the server it is here to test
		# against, under a comment claiming the opposite.
		ender server offline suite-server > /dev/null || echo "  The local server would not go offline-mode" >&2
	else
		echo "  The local server instance could not be set up" >&2
	fi

	# Advisory only: exits nonzero when the pin is behind, which is not a failure of this run.
	if command -v mc-meta > /dev/null; then
		echo "Mod suite target:"
		mc-meta check $suiteProps || true
	fi

	# Inside this block, because clientDir is assigned inside it: outside, a machine with no
	# pandorical called this with an empty argument and it returned silently, so the retired
	# addresses stayed in the list with nothing saying why.
	mcEnsureServerList $clientDir
else
	echo "~/Projects/minecraft/pandorical not found - skipping the suite client and server"
fi
