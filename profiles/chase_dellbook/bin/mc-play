#!/bin/zsh
# Launch the suite client straight into the house server.
#
#   mc-play          join the house server
#   mc-play --menu   stop at the title screen (singleplayer, or a settings run)
#
# The instance is generated by dot-update.d/minecraft, pinned to the same game
# and loader versions the household server runs. This is the reason Prism is
# installed here at all: the Mojang launcher can select a version but cannot be
# told to join a server, so playing meant clicking through the launcher, the
# title screen and the server list every time.

# An array rather than ${server:+--server $server}: zsh does not word-split an
# unquoted expansion the way sh does, so that form hands Prism a single argument
# reading "server <address>" and it exits on an unknown option. An empty array
# disappears from the command line instead, which is what --menu wants.
# The suite server's address, kept in priv-config so one edit moves every machine.
#
# No fallback. It used to fall back to htpc.home, the machine the server ran on
# before it moved to the rented box, and a fallback to a host that is not
# serving is worse than none: the launch goes past the title screen, fails to
# connect, and says nothing about why. Without an address this stops at the
# title screen with the server list one click away.
source "$HOME/.dotfiles/bin/lib/minecraft"

suiteServer=$(mcServerAddress)
joinServer=()

[[ -n $suiteServer ]] && joinServer=(--server "$suiteServer")

[[ $1 == --menu ]] && joinServer=()

command -v prismlauncher > /dev/null 2>&1 || {
	echo "prismlauncher is not installed - it comes from this profile's aptfile" >&2

	exit 1
}

# By name, not by path: unlike the htpc's Steam shortcut this runs from a normal
# interactive shell, where PATH is already whatever the profile made it.
exec prismlauncher --launch suite $joinServer
