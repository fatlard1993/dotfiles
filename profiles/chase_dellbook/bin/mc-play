#!/bin/zsh
# Launch the suite client straight into the house server.
#
#   mc-play          join the house server
#   mc-play --menu   stop at the title screen (singleplayer, or a settings run)
#
# The instance is built by dot-update.d/minecraft and pinned to the same game and
# loader the household server runs.
#
# This used to shell out to Prism, which was installed on every machine in the fleet
# for one reason: the Mojang launcher can select a version but cannot be told to join
# a server, so playing meant clicking through a launcher, a title screen and a server
# list every time. ender takes --server directly, so there is no second launcher left
# to keep in step with the first.

source "$HOME/.dotfiles/bin/lib/minecraft"

# An array rather than ${server:+--server $server}: zsh does not word-split an
# unquoted expansion the way sh does, so that form hands a single argument reading
# "server <address>" to something that wants two. An empty array disappears from the
# command line instead, which is what --menu wants.
#
# No fallback. It used to fall back to htpc.home, the machine the server ran on before
# it moved to the rented box, and a fallback to a host that is not serving is worse
# than none: the launch goes past the title screen, fails to connect, and says nothing
# about why. Without an address this stops at the title screen with the server list one
# click away.
suiteServer=$(mcServerAddress)
joinServer=()

[[ -n $suiteServer ]] && joinServer=(--server $suiteServer)

[[ $1 == --menu ]] && joinServer=()

command -v ender > /dev/null 2>&1 || {
	echo "ender is not installed - dot-update.d/minecraft clones and links it" >&2

	exit 1
}

exec ender launch suite $joinServer
