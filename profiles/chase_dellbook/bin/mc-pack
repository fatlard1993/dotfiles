#!/usr/bin/env python3
"""Cut the suite's packs, in the shapes launchers and servers take.

    mc-pack [--kind client|server|single|all] [--version V] [--id MOD=PROJECT:FILE ...] [--out DIR]

Three packs, each drawn from what the mods declare about themselves and from the pin,
never from a typed list of jars:

  client  <name>-client-<version>.zip and .mrpack: the client-mods.txt set plus Fabric API,
          for a player joining a suite server
  server  <name>-server-<version>.zip: every mod whose manifest is not client-only, in a
          mods/ folder with a start script that fetches the pinned Fabric launcher; unzip
          it, accept the eula, run it
  single  <name>-<version>.zip and .mrpack: every mod whose manifest is not server-only,
          for a singleplayer world with the whole suite in it

The CurseForge zips carry a manifest.json of project and file ids, resolved from the
CurseForge mirror by the jar's own name, and overrides/ for any mod the mirror cannot
place (an unpublished one, or one uploaded within the hour). The mrpacks carry every jar
as an override: none of the suite is on Modrinth, so the index pins only game and loader.

The pin is pandorical's gradle.properties, the mods are client-mods.txt, the slugs are
curseforge-slugs.txt, all in priv-config. A mod the mirror has not indexed yet can be
given by hand with --id (the numbers are on its CurseForge project page and file page).
The mirror lags a fresh upload by an hour or so; a pack cut before it catches up simply
carries that jar as an override, and says so.
"""
import argparse
import datetime
import json
import os
import re
import sys
import urllib.request
import zipfile

SUITE = os.environ.get("MINECRAFT_SUITE", os.path.expanduser("~/Projects/minecraft"))
DATA = os.environ.get("MINECRAFT_DATA", os.path.expanduser("~/.priv-config/minecraft"))
FABRIC_API_PROJECT = 306612


def prop(path, key):
    for line in open(path):
        k, sep, v = line.partition("=")
        if sep and k.strip() == key:
            return v.strip()
    return None


def listed(path):
    return [l.strip() for l in open(path) if l.strip() and not l.startswith("#")]


def slugs():
    out = {}
    for line in listed(os.path.join(DATA, "curseforge-slugs.txt")):
        parts = line.split()
        if len(parts) >= 2:
            out[parts[0]] = parts[1]
    return out


def jar_for(mod):
    """The jar the mod's build declares, the same reading mc-deploy-client does."""
    d = os.path.join(SUITE, mod)
    version = prop(os.path.join(d, "gradle.properties"), "mod_version")
    name = None
    m = re.search(r"archivesName\s*=\s*project\.(\w+)", open(os.path.join(d, "build.gradle")).read())
    if m:
        name = prop(os.path.join(d, "gradle.properties"), m.group(1))
    name = name or mod
    jar = os.path.join(d, "build", "libs", f"{name}-{version}.jar")
    return jar if os.path.exists(jar) else None


def widget(slug):
    try:
        # A named agent: the mirror answers an anonymous Python client with nothing.
        req = urllib.request.Request(f"https://api.cfwidget.com/minecraft/mc-mods/{slug}",
                                     headers={"User-Agent": "mc-pack (justfatlard suite)"})
        with urllib.request.urlopen(req, timeout=20) as r:
            data = json.load(r)
        return data if isinstance(data, dict) and "id" in data else None
    except Exception:
        return None


# What CurseForge lists beside a file's game versions that is not one: which side it
# runs on, and which loader it is for. Everything else in that list is a game version.
NOT_A_GAME_VERSION = {"Client", "Server", "Fabric", "Forge", "Quilt", "NeoForge", "Rift", "LiteLoader"}


def game_versions(f):
    return {v for v in f.get("versions", []) if v not in NOT_A_GAME_VERSION}


def resolve(slug, jar_name, version):
    """(projectID, fileID, game versions) for the file whose display is this jar, or None."""
    data = widget(slug)
    if not data:
        return None
    for f in data.get("files", []):
        display = f.get("display", "")
        if display == jar_name or version in display:
            return data["id"], f["id"], game_versions(f)
    return None


def environment(mod):
    """What the mod's own manifest says it is for: "*", "client" or "server"."""
    for sub in ("src/main/resources", "src/client/resources"):
        path = os.path.join(SUITE, mod, sub, "fabric.mod.json")
        if os.path.exists(path):
            return json.load(open(path)).get("environment", "*")
    return None


def suite_mods():
    """Every directory that is a suite mod, with its declared environment."""
    out = {}
    for mod in sorted(os.listdir(SUITE)):
        env = environment(mod)
        if env is not None and os.path.exists(os.path.join(SUITE, mod, "gradle.properties")):
            out[mod] = env
    return out


def fabric_api_jar(version):
    root = os.path.expanduser("~/.gradle/caches/modules-2/files-2.1/net.fabricmc.fabric-api/fabric-api")
    for dirpath, _, files in os.walk(root):
        for f in files:
            if f == f"fabric-api-{version}.jar":
                return os.path.join(dirpath, f)
    return None


def place(mods, api_jar, api, slug_of, by_hand):
    """For each mod (and Fabric API): a CurseForge reference, or the jar as an override.

    Also the game version the pack should declare. CurseForge checks every file a pack
    references against the version the pack says it is for, and a file that does not carry
    that version is refused - "FileId N is invalid for modpack M with mod loader Fabric",
    which names the loader and so reads like a loader problem. It is not. Fabric API tags
    its snapshot builds under one bucket for the whole cycle while this suite's own mods
    are tagged per snapshot, so the two had no version in common and the pack declared a
    third thing again: the Mojang version id, which is what Modrinth wants and CurseForge
    has never heard of.

    So the version is read off the files rather than off the pin, and anything that does
    not carry it ships as an override instead of a reference.
    """
    found = []
    hit = resolve("fabric-api", os.path.basename(api_jar), api)
    if hit:
        found.append(("fabric-api " + api, api_jar, hit))
    else:
        found.append(("fabric-api " + api, api_jar, None))
    for mod in mods:
        jar = jar_for(mod)
        if not jar:
            sys.exit(f"no jar built for {mod}: run mc-build {mod}")
        version = prop(os.path.join(SUITE, mod, "gradle.properties"), "mod_version")
        hit = by_hand.get(mod)
        if not hit and mod in slug_of:
            hit = resolve(slug_of[mod], os.path.basename(jar), version)
        if hit and len(hit) == 2:
            # by_hand pairs carry no version list; they are trusted as given.
            hit = (hit[0], hit[1], None)
        found.append((f"{mod} {version}", jar, hit))

    # The version the most files agree on. Not the one the most files have in common:
    # a single oddly tagged file would empty that and send the whole pack to overrides.
    tally = {}
    for _, _, hit in found:
        if hit and hit[2]:
            for v in hit[2]:
                tally[v] = tally.get(v, 0) + 1
    declared = max(tally, key=lambda v: (tally[v], v)) if tally else None

    files, overrides, lines = [], [], []
    for label, jar, hit in found:
        if hit and (hit[2] is None or declared in hit[2]):
            files.append({"projectID": hit[0], "fileID": hit[1], "required": True})
            lines.append(f"{label}: project {hit[0]} file {hit[1]}")
            continue
        overrides.append(jar)
        if not hit:
            why = "mirror has no such file"
        else:
            why = f"published for {', '.join(sorted(hit[2])) or 'nothing'}, not {declared}"
        lines.append(f"{label}: as an override ({why})")
    return files, overrides, lines, declared


def write_cf(path, name, version, mc, loader, files, overrides, lines):
    """`mc` here is CurseForge's own game version tag, not the Mojang version id."""
    manifest = {
        "minecraft": {"version": mc, "modLoaders": [{"id": f"fabric-{loader}", "primary": True}]},
        "manifestType": "minecraftModpack", "manifestVersion": 1,
        "name": name, "version": version, "author": "justfatlard",
        "files": files, "overrides": "overrides",
    }
    with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as z:
        z.writestr("manifest.json", json.dumps(manifest, indent=2))
        z.writestr("modlist.html", "<ul>" + "".join(f"<li>{l}</li>" for l in lines) + "</ul>")
        z.writestr("overrides/.keep", "")
        for jar in overrides:
            z.write(jar, "overrides/mods/" + os.path.basename(jar))


def write_mrpack(path, name, version, mc, loader, summary, jars):
    index = {"formatVersion": 1, "game": "minecraft", "versionId": version, "name": name,
             "summary": summary, "dependencies": {"minecraft": mc, "fabric-loader": loader}, "files": []}
    with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as z:
        z.writestr("modrinth.index.json", json.dumps(index, indent=2))
        for jar in jars:
            z.write(jar, "overrides/mods/" + os.path.basename(jar))


def write_server(path, name, version, mc, loader, api_jar, mods):
    """A server folder: mods/ and a start script. The Fabric launcher is fetched by the
    script rather than shipped, so the zip is the suite and nothing else's."""
    url = f"https://meta.fabricmc.net/v2/versions/loader/{mc}/{loader}/1.1.2/server/jar"
    readme = f"""{name} server {version} - Minecraft {mc}, Fabric Loader {loader}

1. Java 25 or newer on the machine.
2. Unzip this somewhere; everything runs from this folder.
3. Run start.sh (Linux, macOS) or start.bat (Windows). The first run fetches the
   Fabric server launcher for {mc}, then stops at the EULA: read eula.txt, set
   eula=true, run it again.
4. Players connect with the client pack ({name}-client), or with a stock client
   (they will see less).

The suite's server-side mods are in mods/. Spawn Lock is among them: set a password
with /spawnlock set <word> as an operator, or the door stays open and says so in the log.
"""
    start_sh = f"""#!/bin/sh
# Fetch the pinned Fabric launcher once, then run the server.
set -e
cd "$(dirname "$0")"
[ -f fabric-server.jar ] || curl -fL -o fabric-server.jar "{url}"
exec java -Xms2G -Xmx6G -jar fabric-server.jar nogui
"""
    start_bat = f"""@echo off
cd /d %~dp0
if not exist fabric-server.jar curl -fL -o fabric-server.jar "{url}"
java -Xms2G -Xmx6G -jar fabric-server.jar nogui
pause
"""
    with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as z:
        z.writestr("README.txt", readme)
        info = zipfile.ZipInfo("start.sh"); info.external_attr = 0o755 << 16
        z.writestr(info, start_sh)
        z.writestr("start.bat", start_bat)
        z.write(api_jar, "mods/" + os.path.basename(api_jar))
        for mod in mods:
            jar = jar_for(mod)
            if not jar:
                sys.exit(f"no jar built for {mod}: run mc-build {mod}")
            z.write(jar, "mods/" + os.path.basename(jar))


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--kind", default="all", choices=["client", "server", "single", "all"])
    ap.add_argument("--version", default=datetime.date.today().strftime("%Y.%m.%d"))
    ap.add_argument("--name", default="justfatvanilla")
    ap.add_argument("--id", action="append", default=[], metavar="MOD=PROJECT:FILE")
    ap.add_argument("--out", default=os.path.join(SUITE, "dist"))
    args = ap.parse_args()

    pin = os.path.join(SUITE, "pandorical", "gradle.properties")
    mc, loader, api = prop(pin, "minecraft_version"), prop(pin, "loader_version"), prop(pin, "fabric_version")
    by_hand = {}
    for spec in args.id:
        mod, ids = spec.split("=", 1)
        p, f = ids.split(":")
        by_hand[mod] = (int(p), int(f))
    slug_of = slugs()
    api_jar = fabric_api_jar(api)
    if not api_jar:
        sys.exit(f"no fabric-api-{api}.jar in the gradle cache: run mc-build first")
    os.makedirs(args.out, exist_ok=True)
    envs = suite_mods()
    kinds = ["client", "server", "single"] if args.kind == "all" else [args.kind]
    print(f"{args.name} {args.version} for {mc} / fabric {loader}")

    if "client" in kinds:
        mods = listed(os.path.join(DATA, "client-mods.txt"))
        files, overrides, lines, declared = place(mods, api_jar, api, slug_of, by_hand)
        stem = os.path.join(args.out, f"{args.name}-client-{args.version}")
        write_cf(stem + ".zip", f"{args.name}-client", args.version, declared or mc, loader, files, overrides, lines)
        write_mrpack(stem + ".mrpack", f"{args.name}-client", args.version, mc, loader,
                     "The client half of the justfatlard mod suite", [api_jar] + [jar_for(m) for m in mods])
        print("client:"); [print("  " + l) for l in lines]; print(f"  wrote {stem}.zip and .mrpack")

    if "server" in kinds:
        mods = [m for m, env in envs.items() if env != "client"]
        stem = os.path.join(args.out, f"{args.name}-server-{args.version}")
        write_server(stem + ".zip", args.name, args.version, mc, loader, api_jar, mods)
        print(f"server: {len(mods)} mods + fabric-api\n  wrote {stem}.zip")

    if "single" in kinds:
        mods = [m for m, env in envs.items() if env != "server"]
        files, overrides, lines, declared = place(mods, api_jar, api, slug_of, by_hand)
        stem = os.path.join(args.out, f"{args.name}-{args.version}")
        write_cf(stem + ".zip", args.name, args.version, declared or mc, loader, files, overrides, lines)
        write_mrpack(stem + ".mrpack", args.name, args.version, mc, loader,
                     "The whole justfatlard mod suite, for a singleplayer world", [api_jar] + [jar_for(m) for m in mods])
        refs = sum(1 for l in lines if "project" in l); ovr = len(lines) - refs
        print(f"single: {refs} by reference, {ovr} as overrides\n  wrote {stem}.zip and .mrpack")


if __name__ == "__main__":
    main()
