#!/usr/bin/env bash
# Keep every mod in the suite current on Modrinth: create what has no project, then upload,
# describe and illustrate the lot.
#
#   mc-publish-batch            the day's run
#   mc-publish-batch --dry-run  say what it would do
#
# Modrinth allows ten new projects per UTC day and answers the eleventh with a 400 saying so.
# That is a day boundary rather than a rolling window, so on UTC-7 the quota turns over at
# 17:00 local and a batch run in the evening is competing with the previous evening's. Hence
# the timer at 17:05: the first minutes of a fresh allowance.
#
# Creating is the only step with a limit. Uploading a jar, setting a description, an icon or a
# gallery are not rationed, so every mod in the queue gets those on every run - the ones made
# today because they need it, and the rest because it is how a correction to a README reaches
# the page it is already on.
set -uo pipefail

# mc-publish is found by where this script is, not by PATH. A systemd timer starts with a minimal
# environment, and a login bash reads ~/.profile, which adds ~/bin and ~/.local/bin and nothing
# else - the dotfiles bin is put on PATH by the zsh config, which bash never reads. So the first
# scheduled run died with "mc-publish-batch: command not found" before it did anything, and had it
# got past that it would have died again on its own sibling.
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
case ":$PATH:" in
	*":$HERE:"*) ;;
	*) PATH="$HERE:$PATH" ;;
esac
export PATH

# Every publishable mod, not a hand-kept queue. The queue was written when creating was the
# bottleneck and a backlog had to be worked in order; every mod has a project now, so a list
# that names a subset only means the rest never get their description, icon or gallery pushed
# when a README changes. mc-publish works out what is publishable from the suite itself.

DRY=""
[ "${1:-}" = "--dry-run" ] && DRY="--dry-run"

echo "== $(date '+%Y-%m-%d %H:%M %Z')"

# Create first: everything after it wants the project to exist. mc-publish stops itself when
# the day's ten are spent and says which are left, so this does not need to count.
mc-publish --create --all $DRY

# Then the parts with no daily limit. Each is asked of every mod: one that is not up yet
# answers "no project yet" and costs one request, which is cheaper than tracking which ones
# today's run happened to make.
for step in --upload --sync --icon --gallery; do
	echo "-- ${step#--}"
	mc-publish "$step" --all $DRY
done

echo "== done $(date '+%H:%M')"
