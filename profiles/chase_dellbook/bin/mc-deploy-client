#!/usr/bin/env bash
# Ship the client half of the suite to every client machine, or to a thumb drive.
#
#   ./deploy-client.sh                sync the local client, then stage+swap the rest
#   ./deploy-client.sh --local        the local client only
#   ./deploy-client.sh --stage-only   stage the remote clients; swap on a later --swap
#   ./deploy-client.sh --swap         swap what is staged (skips a client that is running)
#   ./deploy-client.sh --client NAME  restrict any of the above to one client
#   ./deploy-client.sh --usb DIR      write the whole client set to DIR
#   ./deploy-client.sh --prefetch     pull the pinned game jar onto every client, now
#   ./deploy-client.sh --clients      list the clients and say which are reachable
#
# A full run also refreshes any connected drive already carrying a set, so the
# thumb drive keeps up without being asked. A set is the loose jars plus
# suite-guest.zip, a ready-made Prism instance built from those same jars.
#
# Same hazard as the server, same shape of answer: the JVM reads classes out of
# a mod jar lazily, so replacing one under a running game does not fail at the
# copy, it fails much later when a class nobody had needed yet comes up missing.
# Staging elsewhere and swapping while the game is closed removes the window.
#
# --prefetch is the one mode that is safe with a game open, and it exists because a
# version bump is mostly one 40MB download per machine. The jar lands at a path named
# for the version it is, so nothing a running game has open is touched and no pin
# moves; the switch afterwards is metadata and a file rename. Run it the day before,
# while everyone is playing on the old version, and the bump costs them a relaunch
# rather than a wait. It follows the suite's pin, so it fetches whatever was just
# bumped to.
#
# Which mods count as client-side is in the suite's client-mods.txt, and which
# machines get them is in clients.txt beside it. A suite mod that is no longer on
# that list is taken back off every client on the next swap: its jar is known by
# the stem the suite builds it under, so a jar that is not the suite's is never
# touched.
set -euo pipefail
# On PATH now rather than sitting in the suite, so the suite is named
# instead of inferred from $0. MINECRAFT_SUITE overrides it.
SUITE="${MINECRAFT_SUITE:-$HOME/Projects/minecraft}"
[ -d "$SUITE" ] || { echo "no mod suite at $SUITE" >&2; exit 2; }
cd "$SUITE" || exit 2

# Suite composition (which mods are client-side, which CurseForge slug each
# publishes under) lives in priv-config, tracked with the account it
# describes, rather than in the workspace where it had no remote at all.
DATA="${MINECRAFT_DATA:-$HOME/.priv-config/minecraft}"


LOCAL="$HOME/Projects/minecraft-client"

# --client NAME restricts everything to one entry; empty means all of them. It is
# pulled out rather than being positional so it can go either side of the mode.
only=""
args=()
while [ $# -gt 0 ]; do
	case "$1" in
		--client) only="${2:?--client needs a name}"; shift 2 ;;
		*) args+=("$1"); shift ;;
	esac
done
mode="${args[0]:-full}"

mods() {
	grep -vE '^\s*(#|$)' "$DATA/client-mods.txt"
}

# Each line is "name ssh-target instance-dir"; see clients.txt for the why.
clients() {
	local file="$DATA/clients.txt"
	if [ ! -f "$file" ]; then
		echo "no client list at $file" >&2
		return 1
	fi
	if [ -n "$only" ]; then
		awk -v want="$only" '$1 !~ /^#/ && NF >= 3 && $1 == want' "$file"
	else
		awk '$1 !~ /^#/ && NF >= 3' "$file"
	fi
}

# Off, asleep, or with no sshd: skipped with a note rather than failing the run.
#
# These are household laptops, not infrastructure. Most of them are shut most of
# the time, and a sync that aborts on the first one that is would never finish on
# the day somebody actually wanted it to.
reachable() {
	ssh -n -o BatchMode=yes -o ConnectTimeout=5 "$1" true 2>/dev/null
}

# fabric-api is nobody's mod here, so it is absent from client-mods.txt. It still
# has to go out with every set: a machine being set up for the first time has no
# Minecraft on it yet, let alone a fabric-api, and four suite jars without it is a
# client that will not start.
#
# Resolved from the pin rather than from the local client's mods/, which is where
# it used to come from. That made whatever had been copied in by hand the version
# every client got, and it sat at 0.158.0 while the pin moved to 0.158.2 - unnoticed
# only because the manifests asked for "*". They name a floor now, so a stale copy
# is a client that refuses to start rather than one that crashes later.
api_jar() {
	local want
	want=$(grep -E '^\s*fabric_version' pandorical/gradle.properties 2>/dev/null \
		| head -1 | sed 's/.*=\s*//' | tr -d '[:space:]')
	[ -z "$want" ] && return 1
	find "$HOME/.gradle/caches/modules-2" -name "fabric-api-$want.jar" 2>/dev/null \
		| grep -v sources | head -1
}

# The mod a jar belongs to, with the version taken off: "loot-ender-1.1.3.jar"
# becomes "loot-ender". Anchored on the last hyphen that starts a number, so a
# version with a word in it still comes apart: "village-castles-0.2.1-alpha.jar"
# defeated the simpler rule and left that mod out of every dedupe.
stem_of() {
	echo "$1" | sed 's/\(.*\)-[0-9].*\.jar$/\1/'
}

# The stems of every suite jar that is NOT a client mod: what a client should not be
# carrying. A mod that came off the list, or one that was never on it and got there by
# hand. Read from the suite's own builds so the names are the ones the jars really
# have, and so a jar from elsewhere in mods/ is never mistaken for ours.
retired_stems() {
	local dir jar stem keep
	keep=" $(mods | tr '\n' ' ') "
	for dir in */; do
		dir=${dir%/}
		[ -f "$dir/gradle.properties" ] || continue
		case "$keep" in *" $dir "*) continue ;; esac
		jar=$(jar_for "$dir") || continue
		stem=$(stem_of "$(basename "$jar")")
		echo "$stem"
	done
}

jar_for() {
	# The jar this mod currently declares itself to be: the archive name its build.gradle
	# takes from gradle.properties (mod_id for most, archives_base_name for the rest),
	# joined to the version. Read, not globbed. Gradle never clears build/libs, so a
	# rename leaves the old jar beside the new one at the same version, and a glob
	# sorted alphabetically shipped "better-companions-1.0.0.jar" over
	# "better-companions-justfatlard-1.0.0.jar": the server came back running the old
	# mod id, and two others it had never been told about were simply gone.
	local version prop name jar
	version=$(grep -E '^\s*mod_version' "$1/gradle.properties" 2>/dev/null | head -1 | sed 's/.*=\s*//' | tr -d '[:space:]')
	[ -z "$version" ] && return 1
	prop=$(sed -n 's/.*archivesName *= *project\.\([A-Za-z_]*\).*/\1/p' "$1/build.gradle" 2>/dev/null | head -1)
	name=""
	[ -n "$prop" ] && name=$(grep -E "^\s*$prop\s*=" "$1/gradle.properties" 2>/dev/null | head -1 | sed 's/.*=\s*//' | tr -d '[:space:]')
	# No archivesName line means Gradle's default, the project name, which is the folder.
	[ -z "$name" ] && name=$(basename "$1")
	jar="$1/build/libs/$name-$version.jar"
	[ -f "$jar" ] || return 1
	echo "$jar"
}

# client_running HOST INSTANCE
client_running() {
	# Asked of the filesystem, the way local_running asks. The command-line match
	# this used to make could not see a Prism launch: Prism runs the game through
	# its own instance directory and never puts the configured game dir on the
	# command line, so the guard said "clear" while a game was open, and the swap
	# went in under it - a snapshot-10 client on the thickpad kept its old jars in
	# memory all morning while the folder said pre-1. A java process whose working
	# directory or open files sit under the instance dir is the hazard itself.
	#
	# POSIX sh on stdin, because the remote shells differ (zsh, bash). No -n on
	# this ssh: -n is /dev/null on stdin, which is where the script is.
	#
	# A game run by another user (the kid seat, reached over a different login)
	# keeps its cwd and fd links unreadable, so the command line is the second
	# signal: Prism passes --gameDir with the instance path, and either the
	# configured path or its resolved target may be the one on the line.
	ssh "$1" sh -s -- "$2" <<'REMOTE'
inst=$1
root=$(readlink -f "$inst" 2>/dev/null || echo "$inst")
for dir in /proc/[0-9]*; do
	[ "$(cat "$dir/comm" 2>/dev/null)" = java ] || continue
	target=$(readlink "$dir/cwd" 2>/dev/null)
	case "$target" in "$root"|"$root"/*) exit 0 ;; esac
	for fd in "$dir"/fd/*; do
		target=$(readlink "$fd" 2>/dev/null) || continue
		case "$target" in "$root"/*) exit 0 ;; esac
	done
	line=$(tr '\0' ' ' < "$dir/cmdline" 2>/dev/null)
	case "$line" in *"$inst"*|*"$root"*) exit 0 ;; esac
done
exit 1
REMOTE
}

# Set by local_running so the refusal can name the process rather than the guess.
LOCAL_CLIENT_PID=""

local_running() {
	# Same lazy-class-loading hazard as the server: replacing a jar under a
	# running game succeeds at the copy and fails much later.
	#
	# Asked of the filesystem rather than of command lines. Matching pgrep -f
	# against $LOCAL could never fire: Prism launches the game through a
	# symlinked instance directory and passes that path, so the resolved target
	# this variable holds never appears in the command line at all. The same
	# shape of failure as the comm truncation the old comment here warned about,
	# and with the same result - a guard that cannot match reports "clear"
	# forever. It waved a sync through underneath a running client.
	#
	# A java process holding a file open under the client directory is the
	# hazard itself rather than a stand-in for it, so this holds however the
	# game was launched, and cannot match the shell that is asking.
	LOCAL_CLIENT_PID=""

	local root dir pid target fd
	root=$(realpath "$LOCAL" 2>/dev/null || echo "$LOCAL")

	for dir in /proc/[0-9]*; do
		[ "$(cat "$dir/comm" 2>/dev/null)" = java ] || continue
		pid=${dir#/proc/}

		# Cheap first: a launcher puts the game's working directory in its own
		# instance folder, so this answers for the common case in one readlink.
		target=$(readlink "$dir/cwd" 2>/dev/null) || target=""
		case "$target" in "$root" | "$root"/*) LOCAL_CLIENT_PID=$pid; return 0 ;; esac

		# Otherwise ask what it still has open: a JVM holds every mod jar it
		# loaded for the life of the process.
		for fd in "$dir"/fd/*; do
			[ -e "$fd" ] || continue
			target=$(readlink "$fd" 2>/dev/null) || continue
			case "$target" in "$root"/*) LOCAL_CLIENT_PID=$pid; return 0 ;; esac
		done
	done

	return 1
}

sync_local() {
	if local_running; then
		echo "the local client is running (pid $LOCAL_CLIENT_PID): not touching its jars" >&2
		return 1
	fi

	mkdir -p "$LOCAL/mods"
	local count=0
	while read -r mod; do
		local jar
		jar=$(jar_for "$mod") || true
		if [ -z "$jar" ]; then
			echo "  !! no jar built for $mod" >&2
			continue
		fi
		# Drop the old build first: a version bump renames the jar, and two
		# copies of one mod stop Fabric starting at all.
		rm -f "$LOCAL/mods/$mod"-*.jar
		cp "$jar" "$LOCAL/mods/"
		echo "  local $(basename "$jar")"
		count=$((count + 1))
	done < <(mods)

	# Fabric API on the same terms. This copy used to be placed by hand and never
	# touched again, which is how it ended up older than the pin every client is
	# built against.
	local api
	api=$(api_jar) || true
	if [ -z "$api" ]; then
		echo "  !! no fabric-api jar matching the pin in the gradle cache: run mc-build first" >&2
	elif [ ! -f "$LOCAL/mods/$(basename "$api")" ]; then
		rm -f "$LOCAL"/mods/fabric-api-*.jar
		cp "$api" "$LOCAL/mods/"
		echo "  local $(basename "$api")"
		count=$((count + 1))
	fi

	# And what should not be here any more.
	local stem old
	for stem in $(retired_stems); do
		for old in "$LOCAL/mods/$stem"-*.jar; do
			[ -e "$old" ] || continue
			rm -f "$old"
			echo "  dropped $(basename "$old") (not a client mod)"
		done
	done

	echo "synced $count jar(s) to the local client"
}

# stage HOST INSTANCE
stage() {
	local host="$1" mods_dir="$2/mods" stage_dir="$2/mods-staged"
	# -n, like every other ssh here that is not being handed a heredoc. Without it
	# ssh reads stdin, and stdin inside the client loop is the list of clients: the
	# first machine staged normally and swallowed every line after its own, so the
	# run ended silently one client short.
	ssh -n "$host" "mkdir -p '$stage_dir'"
	local count=0
	while read -r mod; do
		local jar
		jar=$(jar_for "$mod") || true
		if [ -z "$jar" ]; then
			echo "  !! no jar built for $mod" >&2
			continue
		fi

		local name local_sum remote_sum
		name=$(basename "$jar")
		local_sum=$(md5sum "$jar" | cut -d' ' -f1)
		remote_sum=$(ssh -n "$host" "md5sum '$mods_dir/$name' 2>/dev/null | cut -d' ' -f1" || true)

		if [ "$local_sum" != "$remote_sum" ]; then
			# See the same guard in mc-deploy: without this, staging twice before a
			# swap leaves both versions here and the swap moves both into mods/.
			# find, not a glob: see the same call in mc-deploy.
			ssh -n "$host" "find '$stage_dir' -maxdepth 1 -name '$(stem_of "$name")-*.jar' -delete"
			scp -q "$jar" "$host:$stage_dir/" </dev/null
			echo "  staged $name"
			count=$((count + 1))
		fi
	done < <(mods)

	local api name local_sum remote_sum
	api=$(api_jar) || true
	if [ -n "$api" ]; then
		name=$(basename "$api")
		local_sum=$(md5sum "$api" | cut -d' ' -f1)
		remote_sum=$(ssh -n "$host" "md5sum '$mods_dir/$name' 2>/dev/null | cut -d' ' -f1" || true)
		if [ "$local_sum" != "$remote_sum" ]; then
			scp -q "$api" "$host:$stage_dir/" </dev/null
			echo "  staged $name"
			count=$((count + 1))
		fi
	else
		echo "  !! no fabric-api jar matching the pin in the gradle cache: run mc-build first" >&2
	fi

	echo "staged $count jar(s)"
}

# swap HOST INSTANCE
swap() {
	local host="$1" mods_dir="$2/mods" stage_dir="$2/mods-staged"
	if client_running "$host" "$2"; then
		echo "  $host: client is running, staged jars stay put until it is closed" >&2
		return 1
	fi

	# Fed to `sh` on stdin rather than written into the ssh command line, because
	# the remote login shell is not the same everywhere: htpc runs zsh and the
	# thinkpad runs bash, and the zsh (N) glob qualifier this used to rely on is a
	# syntax error in the other one. Naming the interpreter makes the remote shell
	# stop being a fact this script has to know.
	#
	# Paths are passed as arguments, so they are the only thing here that varies.
	# clients.txt is whitespace-separated, so a path with a space in it could not
	# have been written down in the first place.
	ssh "$host" sh -s -- "$mods_dir" "$stage_dir" "$(retired_stems | tr '\n' ' ')" <<'REMOTE'
set -e
mods_dir=$1
stage_dir=$2
retired=$3

# Jars the list no longer carries go first, staged or not: a client that is closed
# is the one moment they can go.
dropped=0
for stem in $retired; do
	for old in "$mods_dir/$stem"-*.jar; do
		[ -e "$old" ] || continue
		rm -f "$old"
		echo "  dropped $(basename "$old") (not a client mod)"
		dropped=$((dropped + 1))
	done
done

# POSIX has no way to ask whether a glob matched, so the -e test inside the loop
# is what stands in for it: an unmatched glob comes through as its own pattern.
count=0
for jar in "$stage_dir"/*.jar; do
	[ -e "$jar" ] || continue
	count=$((count + 1))
done
if [ "$count" -eq 0 ]; then
	[ "$dropped" -eq 0 ] && echo "  nothing staged"
	exit 0
fi

# A version bump renames the jar, so a plain move leaves both side by side and
# the client will not launch with two copies of one mod.
for jar in "$stage_dir"/*.jar; do
	[ -e "$jar" ] || continue
	base=$(basename "$jar")
	stem=$(echo "$base" | sed 's/\(.*\)-[0-9].*\.jar$/\1/')
	for prev in "$mods_dir/$stem"-*.jar; do
		[ -e "$prev" ] || continue
		if [ "$(basename "$prev")" != "$base" ]; then
			rm -f "$prev"
		fi
	done
done

mv "$stage_dir"/*.jar "$mods_dir/"
echo "  swapped $count jar(s)"
REMOTE
}

# The folder a drive keeps its copy in, and the mark of a drive that wants one.
# A stick already carrying this gets refreshed on every sync; anything else
# plugged in is left alone. Somebody else's drive is not a place to write
# uninvited, and this folder is the only signal that says which is which.
USB_SET_DIR=village-client-mods

# The drive carries a ready-made Prism instance beside the loose jars, because
# Prism cannot always resolve the pinned snapshot from its own metadata server.
# What the instance carries to work around that, and when to stop carrying it,
# is in the template's patches/README.
#
# It is rebuilt out of the folder that was just written rather than from a second
# resolve of the same mods, so the zip and the jars beside it cannot disagree
# about what the client set is. That is the whole reason this is here: the zip
# used to be exported by hand, and a version bump refreshed the loose folder and
# left the instance sitting on the previous mods with nothing saying so.
GUEST_TEMPLATE="$DATA/guest-instance"
GUEST_ZIP=suite-guest.zip
GUEST_DIR=suite

# Client mods the guest instance carries switched off. Prism lists a jar ending in
# .disabled in the instance's Mods tab with its box unticked, so it is one click
# away for whoever wants it and out of the way for everyone else. Couch-controls
# takes over a connected controller, which is the whole point on the couch and a
# surprise on somebody's desk.
GUEST_OFF=(couch-controls)

# A value from the suite's pin file, which is pandorical's by convention.
pin() {
	grep -E "^\s*$1" "$SUITE/pandorical/gradle.properties" 2>/dev/null |
		head -1 | sed 's/.*=\s*//' | tr -d '[:space:]'
}

# The lwjgl the carried component names. It has no pin of its own: it follows the
# Minecraft version, so the patch the instance ships is the only place that knows
# it. Empty once the template stops carrying patches, which is the state where
# nothing local knows it any more.
lwjgl_version() {
	local f="$GUEST_TEMPLATE/patches/org.lwjgl3.json"
	[ -f "$f" ] || return 0
	sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -1
}

# Keep the lines on the drive that can quietly stop being true.
#
# The prose belongs to whoever wrote it; only the version facts are rewritten,
# from the same pins the jars beside it were built against. The Requires: line
# sat there saying snapshot-8 while the suite had moved to snapshot-9, which is
# worse than no README: it sends a reader to the wrong loader with confidence.
#
# The Prism error the page quotes is four more of the same fact, and it is quoted
# so a reader can match it against their screen. It named LWJGL 3.4.2 while the
# instance beside it asked for 3.4.3, so the match came out three lines of four -
# which is the reading that sends somebody hunting a fault that is not there,
# exactly what the paragraph under it says not to do.
usb_readme() {
	local readme="$1/README.txt" mc loader lwjgl
	[ -f "$readme" ] || return 0

	mc=$(pin minecraft_version)
	loader=$(pin loader_version)
	[ -n "$mc" ] && [ -n "$loader" ] || return 0

	# The quoted lines are indented; the capture holds whatever that indent is
	# rather than this script having an opinion about someone else's layout.
	sed -i \
		-e "s|^Requires: Fabric Loader .*|Requires: Fabric Loader $loader for Minecraft $mc.|" \
		-e "s|^\( *\)Could not download metadata for Minecraft .*|\1Could not download metadata for Minecraft $mc|" \
		-e "s|^\( *\)Could not download metadata for Intermediary Mappings .*|\1Could not download metadata for Intermediary Mappings $mc|" \
		-e "s|^\( *\)Could not download metadata for Fabric Loader .*|\1Could not download metadata for Fabric Loader $loader|" \
		"$readme"

	lwjgl=$(lwjgl_version)
	[ -n "$lwjgl" ] || return 0
	sed -i "s|^\( *\)Could not download metadata for LWJGL 3 .*|\1Could not download metadata for LWJGL 3 $lwjgl|" "$readme"
}

# The component list Prism reads, written from the same pins the jars were built
# against rather than kept as a file somebody has to remember to edit.
#
# org.lwjgl3 is named only while patches/ carries it: snapshot-10 wants 3.4.3
# where the published component still says 3.4.2, and once Prism publishes the
# version the patch goes and lwjgl resolves from net.minecraft's own requires.
mmc_pack() {
	local inst="$1" mc="$2" loader="$3" lwjgl
	lwjgl=$(lwjgl_version)

	echo '{'
	echo '    "components": ['
	if [ -n "$lwjgl" ]; then
		printf '        {\n            "uid": "org.lwjgl3",\n            "version": "%s"\n        },\n' "$lwjgl"
	fi
	printf '        {\n            "important": true,\n            "uid": "net.minecraft",\n            "version": "%s"\n        },\n' "$mc"
	printf '        {\n            "uid": "net.fabricmc.intermediary",\n            "version": "%s"\n        },\n' "$mc"
	printf '        {\n            "uid": "net.fabricmc.fabric-loader",\n            "version": "%s"\n        }\n' "$loader"
	echo '    ],'
	echo '    "formatVersion": 1'
	echo '}'
}

# guest_zip SET_DIR - rebuild the instance zip beside the folder it is given.
guest_zip() {
	local set_dir="$1" zip_path staging inst mc loader jar jars=0

	# No template, no instance. A drive seeded before this existed keeps the zip
	# it already has rather than losing it to an empty rebuild.
	[ -d "$GUEST_TEMPLATE" ] || return 0

	mc=$(pin minecraft_version)
	loader=$(pin loader_version)
	if [ -z "$mc" ] || [ -z "$loader" ]; then
		echo "  !! no version pins in pandorical/gradle.properties: guest instance left alone" >&2
		return 1
	fi

	staging=$(mktemp -d) || return 1
	inst="$staging/$GUEST_DIR"
	mkdir -p "$inst/.minecraft/mods"
	cp "$GUEST_TEMPLATE/instance.cfg" "$inst/"

	for jar in "$set_dir"/*.jar; do
		[ -e "$jar" ] || continue
		local name off=""
		name=$(basename "$jar")
		for stem in "${GUEST_OFF[@]}"; do
			[ "$(stem_of "$name")" = "$stem" ] && off=.disabled
		done
		cp "$jar" "$inst/.minecraft/mods/$name$off"
		jars=$((jars + 1))
	done
	if [ "$jars" = 0 ]; then
		echo "  !! no jars in $set_dir: guest instance left alone" >&2
		rm -rf "$staging"
		return 1
	fi

	mmc_pack "$inst" "$mc" "$loader" > "$inst/mmc-pack.json"

	# The components Prism's own metadata does not carry yet, so a guest can import
	# this and launch today rather than when the mirror catches up - which is the whole
	# reason the guest instance exists. Generated from the pin rather than kept in the
	# template beside instance.cfg: a folder of metadata for a version Prism has since
	# published shadows the published component permanently, so it used to come with an
	# instruction to delete it by hand on a day nobody was watching for. Written after
	# mmc-pack.json because the generator reads the pin out of it.
	guest_patches "$inst"

	# The house server already in the multiplayer list, so the first thing a guest
	# does after importing is click it rather than go and ask for an address.
	local address
	address=$(grep -vE '^\s*(#|$)' "$DATA/server-address.txt" 2>/dev/null | head -1 | tr -d '[:space:]')
	if [ -n "$address" ]; then
		python3 "$HOME/.dotfiles/bin/mc-servers" "$inst/.minecraft/servers.dat" home "$address" > /dev/null
	fi

	# Built whole in a temp dir and copied over, so a rebuild that dies halfway
	# leaves the drive's working zip where it is rather than a truncated one.
	zip_path="$(dirname "$set_dir")/$GUEST_ZIP"
	if ( cd "$staging" && zip -qr "$GUEST_ZIP" "$GUEST_DIR" ) && cp "$staging/$GUEST_ZIP" "$zip_path"; then
		echo "  rebuilt $GUEST_ZIP ($jars jars, Minecraft $mc, loader $loader)"
	else
		echo "  !! could not write $zip_path" >&2
		rm -rf "$staging"
		return 1
	fi

	rm -rf "$staging"
}

# Prism components for the pin, into an instance directory that already has an
# mmc-pack.json for the generator to read the version out of. Writes nothing when
# Prism publishes the version, which is the answer that keeps this safe to run
# every time rather than remembered on the day it matters.
guest_patches() {
	local inst="$1"
	[ -x "$HOME/.dotfiles/bin/mc-prism-patch" ] || return 0

	python3 "$HOME/.dotfiles/bin/mc-prism-patch" "$(pin minecraft_version)" "$inst" |
		sed 's/^ */  /'
}

# The loose copy of the same component metadata, for a guest who has an instance
# already and needs only the patches. Built the same way the zip's are, and taken
# away when Prism publishes the version: a folder of metadata for a version Prism
# now carries is worse than none, because it shadows the published component
# permanently.
usb_metadata() {
	local dir="$1/prism-metadata" scratch mc
	[ -d "$dir" ] || return 0

	mc=$(pin minecraft_version)
	[ -n "$mc" ] || return 0

	scratch=$(mktemp -d) || return 1
	mmc_pack "$scratch" "$mc" "$(pin loader_version)" > "$scratch/mmc-pack.json"
	guest_patches "$scratch" > /dev/null

	rm -f "$dir"/*.json
	if [ -d "$scratch/patches" ] && [ -n "$(ls -A "$scratch/patches" 2>/dev/null)" ]; then
		cp "$scratch/patches"/*.json "$dir/"
		echo "  refreshed prism-metadata for $mc"
	else
		rmdir "$dir" 2>/dev/null && echo "  dropped prism-metadata: prism publishes $mc now" ||
			echo "  prism publishes $mc now; prism-metadata emptied"
	fi
	rm -rf "$scratch"
}

usb_write() {
	local dest="$1" jar api count=0

	while read -r mod; do
		jar=$(jar_for "$mod") || true
		if [ -z "$jar" ]; then
			echo "  !! no jar built for $mod" >&2
			continue
		fi
		# Drop any older copy of the same mod first, or a version bump leaves
		# two jars of the same mod behind and Fabric refuses to start.
		rm -f "$dest/$mod"-*.jar
		cp "$jar" "$dest/"
		echo "  copied $(basename "$jar")"
		count=$((count + 1))
	done < <(mods)

	# The drive is a whole handoff set and the README beside it tells the reader to
	# copy every jar in the folder, so it needs one too. See api_jar.
	api=$(api_jar) || true
	if [ -n "$api" ]; then
		rm -f "$dest"/fabric-api-*.jar
		cp "$api" "$dest/"
		echo "  copied $(basename "$api")"
		count=$((count + 1))
	else
		echo "  !! no fabric-api jar matching the pin in the gradle cache: run mc-build first" >&2
	fi

	usb_readme "$dest"
	# One failed rebuild is not a reason to abandon the drive, or the next one:
	# usb_auto walks every drive that carries a set.
	usb_metadata "$dest" || true
	guest_zip "$dest" || true
	sync -f "$dest" 2>/dev/null || true
	echo "client set written to $dest ($count jars)"
}

usb() {
	local dest="$1"
	[ -d "$dest" ] || { echo "no such directory: $dest" >&2; exit 2; }
	usb_write "$dest"
}

# Refresh every connected drive that already carries a set, mounting it if need be.
#
# Columns are ordered with the mount point last because it is the one that can be
# empty, and read would otherwise shift the others into it. lsblk -r escapes
# spaces, which a FAT label is perfectly happy to contain.
usb_auto() {
	local removable kind name mount dest mounted_here drives=0 written=0

	while read -r removable kind name mount; do
		[ "$removable" = 1 ] || continue
		[ "$kind" = part ] || continue

		mounted_here=0
		if [ -z "$mount" ]; then
			# Plugged in but not mounted is the ordinary state of a drive that was
			# safely ejected last time, or of any drive on a machine with nobody
			# logged in to click on it. A sync that skips those is a sync that
			# quietly does nothing on the day it matters. udisks does it without
			# root, the same way the desktop would.
			mount=$(udisksctl mount -b "/dev/$name" 2>/dev/null | sed -n 's/^Mounted .* at //p')
			mount=${mount%.}
			[ -n "$mount" ] || continue
			mounted_here=1
		fi
		mount=${mount//\\x20/ }

		drives=$((drives + 1))
		dest="$mount/$USB_SET_DIR"
		if [ -d "$dest" ]; then
			usb_write "$dest"
			written=$((written + 1))
		fi

		# Left the way it was found. A drive this script mounted is one the user did
		# not, and handing back a mounted drive turns a sync into something they have
		# to remember to eject. Unmount only - never power off, which drops the
		# device off the bus entirely and wants a physical replug to get back.
		if [ "$mounted_here" = 1 ]; then
			sync
			udisksctl unmount -b "/dev/$name" >/dev/null 2>&1 || true
		fi
	done < <(lsblk -rno RM,TYPE,NAME,MOUNTPOINT 2>/dev/null)

	if [ "$drives" -gt 0 ] && [ "$written" -eq 0 ]; then
		echo "usb: a drive is connected but has no $USB_SET_DIR folder; seed one with --usb DIR" >&2
	fi
}

# Runs VERB "host" "instance" for each listed client, skipping any that is not
# answering. One machine being shut is not a reason for the others to miss out.
# The game jar for the pinned version, fetched into every launcher root a machine has.
#
# Asked of the machine rather than worked out from clients.txt: that file names the
# game directory, and where a launcher keeps its jars is a different question with a
# different answer per launcher. A box with both launchers gets both, a box with one
# gets one, and a box with neither says so instead of guessing.
#
# mcEnsureClientJar is the dotfiles' own, so this is the same fetch dot-update does at
# the pin it already has - checksum-verified, written beside the target and moved into
# place, and a no-op when the jar is already right.
#
# One program, run through zsh either way. This script is bash and that library is zsh
# - it globs with (N) and expands with (P) - so sourcing it here rather than handing it
# to a zsh reads as a pile of syntax errors from a file that is not broken.
prefetch_program() {
	cat <<'REMOTE'
version=$1
[[ -r $HOME/.dotfiles/bin/lib/minecraft ]] || {
	echo "  no dotfiles here, so no fetcher to run"
	exit 0
}
source $HOME/.dotfiles/bin/lib/minecraft

roots=()
[[ -d $HOME/.local/share/PrismLauncher ]] &&
	roots+=($HOME/.local/share/PrismLauncher/libraries/com/mojang/minecraft/$version/minecraft-$version-client.jar)
[[ -d $HOME/.minecraft/versions ]] &&
	roots+=($HOME/.minecraft/versions/$version/$version.jar)

(( ${#roots} )) || { echo "  no launcher here to fetch for"; exit 0 }

for dest in $roots; do
	[[ $dest == *PrismLauncher* ]] && which=Prism || which="the mojang launcher"
	had=0
	[[ -f $dest ]] && had=1
	mcEnsureClientJar $version $dest
	if [[ ! -f $dest ]]; then
		echo "  $which: $version could not be fetched"
	elif (( had )); then
		echo "  $which: $version already here"
	else
		echo "  $which: $version fetched"
	fi
done
REMOTE
}

prefetch() {
	prefetch_program | ssh "$1" zsh -s -- "$(pin minecraft_version)"
}

# The local client has no ssh in front of it, the same exception sync_local makes.
prefetch_local() {
	echo "local:"
	prefetch_program | zsh -s -- "$(pin minecraft_version)"
	return 0
}

for_each_client() {
	local verb="$1" name host instance matched=0 rc=0
	# Read the whole list first rather than looping over a pipe. Anything in the
	# body that reads stdin would otherwise eat the rest of it, which is not a
	# hazard worth re-checking every time something is added to the loop.
	local -a rows=()
	mapfile -t rows < <(clients)

	for row in "${rows[@]}"; do
		read -r name host instance <<<"$row"
		matched=1
		if ! reachable "$host"; then
			echo "  $name: no answer on ssh, skipped"
			continue
		fi
		echo "$name:"
		"$verb" "$host" "$instance" || rc=1
	done

	if [ "$matched" = 0 ]; then
		echo "no client matched${only:+ --client $only}" >&2
		return 1
	fi
	return "$rc"
}

# Staging and swapping one machine at a time, so a client only has to be awake
# and answering once per run rather than once per phase.
deploy_client() {
	stage "$1" "$2"
	swap "$1" "$2" || true
}

list_clients() {
	local name host instance state matched=0
	local -a rows=()
	mapfile -t rows < <(clients)

	for row in "${rows[@]}"; do
		read -r name host instance <<<"$row"
		matched=1
		if reachable "$host"; then state=reachable; else state="no answer on ssh"; fi
		printf '  %-14s %-20s %s\n' "$name" "$host" "$state"
	done

	# Silence and success look identical otherwise, and a mistyped --client is
	# exactly the case where they must not.
	if [ "$matched" = 0 ]; then
		echo "no client matched${only:+ --client $only}" >&2
		return 1
	fi
}

case "$mode" in
	--local)      sync_local ;;
	--prefetch)   prefetch_local || true; for_each_client prefetch ;;
	--stage-only) for_each_client stage ;;
	--swap)       for_each_client swap ;;
	--usb)        usb "${args[1]:?usage: $0 --usb DIR}" ;;
	--clients)    list_clients ;;
	full)         sync_local || true; usb_auto || true; for_each_client deploy_client || true ;;
	*) echo "usage: $0 [--local|--stage-only|--swap|--prefetch|--usb DIR|--clients] [--client NAME]" >&2; exit 2 ;;
esac
