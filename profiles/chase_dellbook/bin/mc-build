#!/usr/bin/env bash
# Build every mod in the suite and report a per-repo pass/fail tally.
# "green 36/36" as a command instead of a memory. Run from the workspace root.
#
#   ./build-all.sh              # build all mods
#   ./build-all.sh -q           # quieter: only print the tally and failures
#   ./build-all.sh pandorical   # build one repo and every repo that depends on it
#
# Exit status is the number of failed repos (0 = all green).
set -uo pipefail

# On PATH now rather than sitting in the suite, so the suite is named
# instead of inferred from $0. MINECRAFT_SUITE overrides it.
SUITE="${MINECRAFT_SUITE:-$HOME/Projects/minecraft}"
[ -d "$SUITE" ] || { echo "no mod suite at $SUITE" >&2; exit 2; }
cd "$SUITE" || exit 2

quiet=0
[[ "${1:-}" == "-q" ]] && { quiet=1; shift; }

# A repo is any immediate subdirectory with a gradlew.
mapfile -t repos < <(for d in */; do [[ -x "${d}gradlew" ]] && echo "${d%/}"; done | sort)

# If a repo is named, build it plus everything that declares it in fabric.mod.json depends.
if [[ -n "${1:-}" ]]; then
	target="$1"
	dependents=("$target")
	for r in "${repos[@]}"; do
		[[ "$r" == "$target" ]] && continue
		# src/*/resources, not src/main: a client-only mod keeps its manifest under
		# src/client, and matching only src/main silently dropped every one of them from
		# the sweep - so an API change broke them while this printed green.
		if rg -q "\"$target\"" "$r"/src/*/resources/fabric.mod.json 2>/dev/null; then
			dependents+=("$r")
		fi
	done
	repos=("${dependents[@]}")
	echo "Building $target and its ${#repos[@]} dependent(s): ${repos[*]}"
fi

# --- Build order ---------------------------------------------------------
#
# Alphabetical order is wrong, and was wrong quietly. Half the suite compiles against a sibling's
# built jar - better-companions against village-quests, nearly everything against block-tip - and
# those siblings sort late: beets-bears needs better-companions and block-tip, and comes before
# both. It only ever worked because a previous run had left the jars lying about.
#
# So any run that did not finish - a Ctrl-C, a failure, a `| head` closing the pipe - could leave a
# provider deleted and unbuilt, and the next run then failed on mods that were perfectly fine, with
# "package justfatlard.village_quests.api does not exist". The build was reporting a real error
# about an imaginary problem, which is the worst kind to chase.
#
# Providers are read from each build.gradle, where a compile-only sibling is named as
# ../<mod>/gradle.properties, so this cannot drift from what the builds actually do.
providers_of() {
	grep -oE '\.\./[a-z0-9-]+/gradle\.properties' "$1/build.gradle" 2>/dev/null |
		sed -E 's|\.\./([a-z0-9-]+)/.*|\1|' | sort -u
}

declare -A in_build=()
for r in "${repos[@]}"; do in_build["$r"]=1; done

# A provider whose jar is missing is pulled in even when it was not asked for: without it every
# dependent fails, and building it is the whole fix. One pass is enough for this suite's depth.
for r in "${repos[@]}"; do
	while read -r p; do
		[[ -z "$p" ]] && continue
		[[ -n "${in_build[$p]:-}" ]] && continue
		[[ -x "$p/gradlew" ]] || continue
		if ! compgen -G "$p/build/libs/*.jar" > /dev/null; then
			echo "Also building $p: $r needs its jar and there is none"
			repos+=("$p")
			in_build["$p"]=1
		fi
	done < <(providers_of "$r")
done

# Depth-first, so a provider is always built before anything that compiles against it. Alphabetical
# within that, so the output stays readable.
declare -A visiting=()
declare -A done_mark=()
ordered=()
visit() {
	local r="$1"
	[[ -n "${done_mark[$r]:-}" ]] && return 0
	# A cycle cannot be ordered; leaving it to fall in after its partner is no worse than the
	# alphabetical order this replaces, and saying so beats looping forever.
	if [[ -n "${visiting[$r]:-}" ]]; then
		echo "warning: $r is part of a build-order cycle" >&2
		return 0
	fi
	visiting["$r"]=1
	while read -r p; do
		[[ -z "$p" ]] && continue
		[[ -n "${in_build[$p]:-}" ]] && visit "$p"
	done < <(providers_of "$r")
	unset 'visiting[$r]'
	done_mark["$r"]=1
	ordered+=("$r")
}
for r in "${repos[@]}"; do visit "$r"; done
repos=("${ordered[@]}")

pass=0
fail=0
failed_repos=()
for r in "${repos[@]}"; do
	# Cleared first, because Gradle never does. A version bump or a rename leaves the
	# previous jar beside the new one, and everything downstream that looks in
	# build/libs (the deploys, a sibling mod's compileOnly integration) then has two
	# to choose from. A mod that fails to build is left with nothing there, which is
	# the honest state: a stale jar that still deploys is how a broken build ships.
	out=$(cd "$r" && rm -f build/libs/*.jar && ./gradlew build -q 2>&1)
	# Taken before anything else runs. This used to be read after the echo below, so in
	# the default noisy mode $? was echo's status rather than gradle's - echo does not
	# fail, so every repo passed. It printed "green 4/4" directly underneath the compile
	# errors it had just shown, three times in one day, and the errors were the only
	# reason anybody noticed.
	status=$?
	[[ $quiet -eq 1 ]] || echo "$out"

	if [[ $status -eq 0 ]]; then
		pass=$((pass + 1))
		printf 'PASS  %s\n' "$r"
	else
		fail=$((fail + 1))
		failed_repos+=("$r")
		printf 'FAIL  %s\n' "$r"
		[[ $quiet -eq 1 ]] && echo "$out" | tail -20
	fi
done

echo "─────────────────────────────────────"
printf 'green %d/%d\n' "$pass" "$((pass + fail))"
((fail > 0)) && printf 'failed: %s\n' "${failed_repos[*]}"
exit "$fail"
