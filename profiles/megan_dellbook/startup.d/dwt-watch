#!/bin/zsh

# Toggles the touchpad's disable-while-typing off while a game window is
# focused (see ubuntu/bin/dwt-watch). Anchored pgrep, same reasoning as
# startup.d/input-watchdog: a bare -f match would see this launcher too.
pgrep -f "^/bin/zsh $HOME/.dotfiles/ubuntu/bin/dwt-watch" > /dev/null \
	|| $HOME/.dotfiles/ubuntu/bin/dwt-watch &
