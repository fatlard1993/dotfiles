#!/bin/zsh

source "$HOME/.dotfiles/bin/lib/dot-util" "$0" "$@"
source "$HOME/.dotfiles/bin/lib/minecraft"

# A player's machine: a client on the house pin, nothing built here.
#
# Bump these two together with every other profile's - a client on a different pin than
# the house server cannot join it. The dev machine reads its pin from pandorical's
# gradle.properties instead, which is the pin these are copies of.
mcVersion=26.3-rc-1
loaderVersion=0.19.5

# Mod jars arrive over ssh from the dev machine (mc-deploy-client, registered in
# priv-config/minecraft/clients.txt) rather than being built or fetched here.
# The client used to live inside Prism's instance folder, which is where the worlds and
# the options are, so it is moved out once before anything else looks for it.
mcAdoptPrismGameDir suite $HOME/minecraft-suite

mcEnsurePlayerClient $mcVersion fabric $HOME/minecraft-suite
