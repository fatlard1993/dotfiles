#!/bin/zsh

source "$HOME/.dotfiles/bin/lib/dot-util" "$0" "$@"
source "$HOME/.dotfiles/bin/lib/minecraft"

# A player's machine: a client on the house pin, nothing built here. Mod jars arrive over
# ssh from the dev machine (mc-deploy-client), not from this file.
mcAdoptPrismGameDir suite $HOME/minecraft-suite || return 1

mcEnsurePlayerClient $mcSuiteVersion fabric $HOME/minecraft-suite suite $mcSuiteLoaderVersion || return 1
