#!/bin/zsh

source "$HOME/.dotfiles/bin/lib/dot-util" "$0" "$@"
source "$HOME/.dotfiles/bin/lib/minecraft"

# A player's machine on two servers. Mod jars arrive over ssh from the dev machine
# (mc-deploy-client), not from this file.
mcEnsurePlayerClient $mcSuiteVersion fabric $HOME/minecraft-suite suite $mcSuiteLoaderVersion || return 1

# The colonies server runs the MineColonies Official pack on its own version and loader,
# which is why it is a separate instance rather than a second address. It is very likely
# online-mode where the house server is not, so it wants a real Microsoft account - one
# sign in, once:
#
#     ender account add
#     ender account assign <name> -i minecolonies
mcReportMissingPackInstance minecolonies "CurseForge, \"MineColonies Official\""
