#!/bin/zsh

# Kid-sized wallpaper menu: two glyph tiles instead of the shared ten-line
# text list (ubuntu/bin/polybar-menu wallpaper). Reached through that
# script's profile dispatch from the bar's wallpaper button.

pgrep -x rofi > /dev/null && exit 0

exec rofi -show wallpaper -show-icons -dpi 131 -me-select-entry "" -me-accept-entry MousePrimary \
	-modi "wallpaper:$HOME/.dotfiles/profiles/guest_thinbook/bin/wallpaper-tiles" \
	-theme $HOME/.dotfiles/profiles/guest_thinbook/rofi/tiles.rasi \
	-theme-str "listview { columns: 2; }"
