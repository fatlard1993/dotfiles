#!/bin/zsh

# mc-play <home|minecolonies> [--menu]
#
# One click onto a server. Each target is an instance built by dot-update.d/minecraft plus
# the server it belongs to; --menu lands on the title screen instead of connecting.

source "$HOME/.dotfiles/bin/lib/minecraft"

case $1 in
	home|'') instance=suite; server=$(mcServerAddress) ;;
	minecolonies) instance=minecolonies; server=turkeyday.modded.fun ;;
	*) echo "usage: mc-play <home|minecolonies> [--menu]" >&2; exit 2 ;;
esac

# An array, not ${server:+--server $server}: zsh does not word-split an unquoted
# expansion, so that form hands over one argument reading "server <address>".
joinServer=()

[[ -n $server ]] && joinServer=(--server $server)

[[ $2 == --menu ]] && joinServer=()

command -v ender > /dev/null 2>&1 || {
	echo "ender is not installed - dot-update.d/minecraft clones and links it" >&2

	exit 1
}

# A desktop button that exits quietly is indistinguishable from one that did nothing, so a
# missing instance is worth a notification. minecolonies is the hand-imported one.
ender ls --names 2>/dev/null | grep -qxF $instance || {
	notify-send "Minecraft" "The $instance instance is not set up on this machine yet, so this button cannot join ${server:-it}"
	echo "no '$instance' instance - see dot-update.d/minecraft" >&2

	exit 1
}

exec ender launch $instance $joinServer
