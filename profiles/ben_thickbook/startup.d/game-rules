#!/bin/zsh

# The desk's games take the whole screen: the ones with a real fullscreen
# mode use it (gcompris -f, tuxpaint --fullscreen=native, frozen-bubble
# --fullscreen, supertuxkart's own config), and the resizable-but-windowed
# ones get fullscreened by the wm instead. Both class spellings: these are
# SDL/GL apps and instance vs class casing differs per toolkit.
for class in Neverball neverball Neverputt neverputt; do
	bspc rule -a "$class" state=fullscreen
done
