#!/bin/zsh

# rofi script mode for the power menu: four glyph tiles. The full-screen
# tiles are the confirmation the shared menu does with a second prompt -
# Escape or a click on empty space lands on nothing.

if [[ -z $1 ]]; then
	printf '%s\0icon\x1f%s\n' \
		"Lock" "system-lock-screen" \
		"Sleep" "weather-clear-night" \
		"Restart" "system-reboot" \
		"Power Off" "system-shutdown"
	exit 0
fi

case $1 in
	"Lock") setsid -f system-lock > /dev/null 2>&1 ;;
	"Sleep") systemctl suspend ;;
	"Restart") setsid -f $HOME/.dotfiles/ubuntu/bin/pc-leave reboot > /dev/null 2>&1 ;;
	"Power Off") setsid -f $HOME/.dotfiles/ubuntu/bin/pc-leave shutdown > /dev/null 2>&1 ;;
esac
