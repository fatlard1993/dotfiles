#!/bin/zsh

# mc-play <home|minecolonies> [--menu]
#
# One click onto a server. Each target is a Prism instance (built or checked
# by dot-update.d/minecraft) plus the server it belongs to; --menu lands on
# the title screen instead.

case ${1:-home} in
	home)        instance=suite;        server=htpc.home ;;
	minecolonies) instance=minecolonies; server=turkeyday.modded.fun ;;
	*) echo "usage: mc-play <home|minecolonies> [--menu]" >&2; exit 2 ;;
esac

joinServer=(--server $server)
[[ $2 == --menu ]] && joinServer=()

command -v prismlauncher > /dev/null 2>&1 || {
	echo "prismlauncher is not installed - it comes from this profile's aptfile" >&2
	exit 1
}

exec prismlauncher --launch $instance $joinServer
