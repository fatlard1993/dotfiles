@theme "~/.dotfiles/ubuntu/rofi/theme.rasi"

/* Sized to the machine's 1600x900 panel at the profile config's dpi (131):
   5 rows of 96px icons + one label line fit the 866px tiled area, and a
   ~251px element holds "NASA Space Place" without ellipsis. The old 160px/48px values were authored on a taller
   screen and paged the grid down to 2 rows of 4. */
* {
	font: "Hack Nerd Font Mono 12";
}

/* A full-width sheet from the top, not fullscreen: the rofi wrapper's
   per-monitor y-offset drops it flush under the bar, which stays visible
   and clickable while the desk is up. Height follows the 4 rows. */
window {
	width: 100%;
	location: north;
}

inputbar {
	enabled: false;
}

listview {
	columns: 8;
	lines: 5;
	flow: horizontal;
	fixed-columns: true;
	spacing: 12px;
	padding: 16px;
}

element {
	orientation: vertical;
	padding: 8px;
}

element-icon {
	size: 96px;
	horizontal-align: 0.5;
}

element-text {
	horizontal-align: 0.5;
	vertical-align: 0.5;
}
