#!/bin/zsh

source "$HOME/.dotfiles/bin/lib/dot-util" "$0" "$@"

# Seeded once, then the home-page's own: it writes back to the resolved file,
# so a symlink into a pull-only tree would dirty it and break the next pull.
[[ -e $HOME/.homePage.json ]] || {
	echo "Seeding home-page bookmarks"

	cp $profilePath/home-page.json $HOME/.homePage.json
}

# Fill in the favicons the seeded json names but never carried - fetched
# on this machine, into the app's favicon dir (see home-page's
# scripts/fetch-favicons.js); reruns are cheap and retry dark sites.
[[ -d $HOME/Projects/home-page ]] && (cd $HOME/Projects/home-page && bun scripts/fetch-favicons.js)
