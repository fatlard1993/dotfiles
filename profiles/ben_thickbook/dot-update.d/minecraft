#!/bin/zsh

source "$HOME/.dotfiles/bin/lib/dot-util" "$0" "$@"
source "$HOME/.dotfiles/bin/lib/minecraft"

# Client only, and a player's machine rather than a developer's: there is no
# suite workspace here to read the pin from, so like htpc this file pins the
# game and loader itself. Bump the three together with htpc/dot-update.d/
# minecraft - a client on a different pin than the house server cannot join it.
# Mod jars are not managed here either: they arrive over ssh from the dev
# machine (mc-deploy-client, registered in priv-config/minecraft/clients.txt).
#
# Two launchers, one game directory. Ben started on the official launcher with
# ~/minecraft-suite as its game dir, and that dir is what clients.txt already
# ships mods to; Prism joins it for mc-play's straight-to-server launch, with
# its instance .minecraft linked to the same place rather than a second copy.
mcVersion=26.3-pre-2
loaderVersion=0.19.5
gameDir=$HOME/minecraft-suite

manifestUrl="https://piston-meta.mojang.com/mc/game/version_manifest_v2.json"
manifest=$(curl -sf $manifestUrl)

if [[ -z $manifest ]]; then
	echo "Couldn't reach the Mojang version manifest - skipping minecraft"

	return
fi

versionJson=$(curl -sf $(echo $manifest | jq -r ".versions[] | select(.id == \"$mcVersion\") | .url"))

if [[ -z $versionJson ]]; then
	echo "Pinned version $mcVersion not in Mojang's manifest - skipping minecraft"

	return
fi

# The full runtime, not -headless: LWJGL wants libawt_xawt and friends.
javaMajor=$(echo $versionJson | jq -r '.javaVersion.majorVersion')

dpkg -s openjdk-$javaMajor-jre > /dev/null 2>&1 || {
	echo "Installing Java $javaMajor (required by Minecraft $mcVersion)"

	sudo env DEBIAN_FRONTEND=noninteractive apt install -y openjdk-$javaMajor-jre
}

mkdir -p $gameDir/mods
fabricVersionId="fabric-loader-$loaderVersion-$mcVersion"

# Same deb repack as tiny_lappy and htpc: Mojang's control file still names the
# pre-rename libgdk-pixbuf2.0-0. Keep the sed in step with theirs.
dpkg -s minecraft-launcher > /dev/null 2>&1 || {
	echo "Installing Minecraft launcher"

	curl -sf -o /tmp/Minecraft.deb https://launcher.mojang.com/download/Minecraft.deb

	rm -rf /tmp/Minecraft.deb.d
	dpkg-deb -R /tmp/Minecraft.deb /tmp/Minecraft.deb.d
	sed -i 's/libgdk-pixbuf2\.0-0/libgdk-pixbuf-2.0-0/' /tmp/Minecraft.deb.d/DEBIAN/control
	dpkg-deb -b --root-owner-group /tmp/Minecraft.deb.d /tmp/Minecraft-fixed.deb

	sudo env DEBIAN_FRONTEND=noninteractive apt install -y /tmp/Minecraft-fixed.deb
	rm -rf /tmp/Minecraft.deb /tmp/Minecraft.deb.d /tmp/Minecraft-fixed.deb
}

# The Fabric installer writes into a launcher directory, it does not create
# one: with no $HOME/.minecraft/launcher_profiles.json it stops at "Launcher
# directory not found" and installs nothing. That file is written by the
# Mojang launcher's first run, so on a machine nobody has opened it on yet -
# which is every fresh install - this step could not succeed. It went
# unnoticed because the machines this ran on had all had a launcher opened
# years earlier. Seed the empty shape instead of depending on that; the
# launcher rewrites the file wholesale anyway, and the block below is what
# puts the suite's profile back into it.
mkdir -p $HOME/.minecraft
[[ -f $HOME/.minecraft/launcher_profiles.json ]] || {
	echo "Seeding an empty launcher profile list (the launcher has not run here yet)"

	echo '{"profiles":{},"version":3}' > $HOME/.minecraft/launcher_profiles.json
}

[[ -d $HOME/.minecraft/versions/$fabricVersionId ]] || {
	echo "Installing Fabric $loaderVersion for Minecraft $mcVersion"

	curl -sf -o /tmp/fabric-installer.jar https://maven.fabricmc.net/net/fabricmc/fabric-installer/1.1.1/fabric-installer-1.1.1.jar
	java -jar /tmp/fabric-installer.jar client -mcversion $mcVersion -loader $loaderVersion
	# Read before rm, which would otherwise be the status this tests - the
	# same trap mc-build's own comment records. Everything below assumes a
	# client that exists, and without this the whole hook ran through a
	# failed install and still finished green.
	fabricStatus=$?
	rm -f /tmp/fabric-installer.jar

	[[ $fabricStatus -eq 0 ]] || {
		echo "  Fabric install failed (status $fabricStatus) - skipping the client setup below" >&2

		return 1
	}
}

mcEnsureClientJar $mcVersion $HOME/.minecraft/versions/$mcVersion/$mcVersion.jar

# The launcher rewrites launcher_profiles.json wholesale on exit, so an edit
# under a running launcher reverts silently. -f: the name is 18 characters and
# pgrep -x truncates comm at 15.
if pgrep -f minecraft-launcher > /dev/null 2>&1; then
	echo "  The Minecraft launcher is open, so its profile list is left alone"
	echo "  (it would overwrite any change on exit). Close it and rerun."
elif [[ -f $HOME/.minecraft/launcher_profiles.json ]]; then
	echo "Ensuring the 'minecraft' launcher profile points at $fabricVersionId"

	python3 - $fabricVersionId "$gameDir" << 'PYEOF'
import json, os, sys, uuid

versionId, gameDir = sys.argv[1], sys.argv[2]
path = f"{os.environ['HOME']}/.minecraft/launcher_profiles.json"

with open(path) as f:
	data = json.load(f)

# Every Fabric install adds its own entry and nothing removes them; keep the
# one managed here and drop stale fabric-loader siblings (matched on
# lastVersionId, since the installer's naming has changed shape before).
for key in [
	k for k, p in data["profiles"].items()
	if p.get("name") != "minecraft"
	and str(p.get("lastVersionId", "")).startswith("fabric-loader-")
	and p.get("lastVersionId") != versionId
]:
	print(f"  dropping the stale installation entry {data['profiles'][key].get('lastVersionId')}")
	del data["profiles"][key]

profile = next((p for p in data["profiles"].values() if p.get("name") == "minecraft"), None)
if profile is None:
	profile = {"name": "minecraft", "type": "custom", "created": "2026-08-25T00:00:00.000Z", "icon": "Grass"}
	data["profiles"][uuid.uuid4().hex] = profile

profile["lastVersionId"] = versionId
profile["gameDir"] = gameDir

with open(path, "w") as f:
	json.dump(data, f)
PYEOF
else
	echo "  No launcher_profiles.json yet - open the Minecraft launcher once and rerun"
fi

command -v prismlauncher > /dev/null 2>&1 || {
	echo "prismlauncher is not installed - skipping the suite instance (aptfile)"

	return
}

prismRoot=$HOME/.local/share/PrismLauncher
instanceDir=$prismRoot/instances/suite

mkdir -p $instanceDir

if [[ -e $instanceDir/.minecraft && ! -L $instanceDir/.minecraft ]]; then
	echo "  $instanceDir/.minecraft is a real directory where a link to $gameDir"
	echo "  was expected - left alone, since moving it would move whatever is inside"
else
	ln -sfn $gameDir $instanceDir/.minecraft
fi

mcEnsureClientJar $mcVersion \
	$prismRoot/libraries/com/mojang/minecraft/$mcVersion/minecraft-$mcVersion-client.jar

# No local component patches. Prism publishes this pin at
# meta.prismlauncher.org, and a patches/ directory left over from a version it
# did not yet carry shadows the published component permanently: the instance
# would keep launching the old game against the new pin. Removed every run so a
# stale set cannot survive a bump.
rm -rf $instanceDir/patches

# Regenerated every run so the pin keeps tracking the server; instance.cfg is
# seeded once and then belongs to Prism's settings UI.
cat > $instanceDir/mmc-pack.json << EOF2
{
	"components": [
		{
			"important": true,
			"uid": "net.minecraft",
			"version": "$mcVersion"
		},
		{
			"uid": "net.fabricmc.intermediary",
			"version": "$mcVersion"
		},
		{
			"uid": "net.fabricmc.fabric-loader",
			"version": "$loaderVersion"
		}
	],
	"formatVersion": 1
}
EOF2

[[ -f $instanceDir/instance.cfg ]] || cat > $instanceDir/instance.cfg << EOF2
InstanceType=OneSix
name=suite
iconKey=default
EOF2

clientPandorical=($gameDir/mods/pandorical-*.jar(N:t))

if (( ! ${#clientPandorical} )); then
	echo "  No Pandorical in the suite instance yet, so it cannot join the house"
	echo "  server. From the dev machine: mc-deploy-client --client ben_thickbook"
fi

# The colonies server (turkeyday.modded.fun, Minecraft 1.21.1) runs the
# MineColonies Official pack ("official-reforged" on CurseForge, NeoForge).
# Prism's CurseForge browser installs it whole, no manual mod downloads - but
# only through the GUI, and that is what keeps this a hand step: Add Instance >
# CurseForge > "MineColonies Official", named exactly "minecolonies" so
# mc-play's --launch finds it.
[[ -d $prismRoot/instances/minecolonies ]] || {
	echo "  No 'minecolonies' Prism instance yet - import the MineColonies Official"
	echo "  Modpack from CurseForge in Prism and name the instance 'minecolonies'"
}

[[ -f $prismRoot/accounts.json ]] || {
	echo "  Prism has no account yet - open it once, finish its setup wizard and"
	echo "  add Ben's Microsoft account. That flow is OAuth, so there is no"
	echo "  headless path; one sitting, and mc-play works from then on."
}
